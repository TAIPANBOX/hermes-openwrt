# The upstream Hermes this repository packages. Sourced by the build and by the gates.
#
# The tag is v2026.9.24 (Hermes Agent v0.21.5). A tag can be moved; a commit cannot, so the
# commit is what the build fetches and what the package records. The checksum is of
# GitHub's archive of that commit; a mismatch stops the build before anything is unpacked.
HERMES_VERSION=0.21.5
HERMES_TAG=v2026.9.24
HERMES_COMMIT=f97608f178d1ffeca59860195ab7da295f7c8e5f
HERMES_TARBALL_SHA256=b71f4b7d4fe5b158ed9bbbeb73f5eb107f2f05e54bd582d32c2d9f718b58d9b0
# Upstream dependencies the router package leaves out, with everything only they need.
# nemo-relay: NVIDIA's Relay runtime, 30 MB; upstream falls back to NoopRelayRuntime.
# pillow-heif: the HEIC/AVIF decoder, 19 MB; upstream imports it inside suppress().
HERMES_EXCLUDE="nemo-relay pillow-heif"
# Libraries carried newer than uv.lock at the pinned commit, for security advisories published
# after it (OSV, read 2026-10-28). Each is the version upstream's own uv.lock moved to by
# v0.22.5, and each still installs on the router's Python 3.13, while every Hermes release after
# 0.21.5 supports Python 3.14 only. mcp-types moves with mcp, which pins it exactly.
#   anyio, httpcore2, httpx2: TLS host name and plain-text proxy advisories
#   certifi: emSign roots whose intermediate keys were compromised
#   mcp, opentelemetry-api, pyjwt, urllib3: token, proxy and memory-bound advisories
#   pillow: 41 decoder advisories; tornado (Telegram add-on): symlinks and response size
HERMES_LIBRARY_FIXES="anyio==4.14.2 certifi==2026.10.19 httpcore2==2.12.0 httpx2==2.12.0 mcp==2.3.0 mcp-types==2.3.0 opentelemetry-api==1.45.1 pillow==13.0.0 pyjwt==2.15.1 tornado==6.5.10 urllib3==2.8.0"
