#!/bin/sh
# @codex 2026-09-19: read all credentials after procd exec, including respawns.
# procd's service list holds paths only; root can still inspect the child environment.
set -eu

KEY_FILE=${1:?hermes-gateway: no key file given}
/usr/bin/python3 /usr/libexec/hermes-memory "${HERMES_MEM_MAX_MB:-512}"

read_required() {
	local path label value
	path=$1
	label=$2
	[ -r "$path" ] || { echo "hermes-gateway: $label $path is unreadable" >&2; return 1; }
	value=$(head -n1 "$path" | tr -d ' \t\r\n')
	[ -n "$value" ] || { echo "hermes-gateway: $label $path is empty" >&2; return 1; }
	printf '%s' "$value"
}

unset OPENAI_API_KEY TELEGRAM_BOT_TOKEN OPENWRT_MCP_TOKEN
key=$(read_required "$KEY_FILE" "provider key file")
export OPENAI_API_KEY="$key"
if [ -n "${HERMES_TELEGRAM_TOKEN_FILE:-}" ]; then
	token=$(read_required "$HERMES_TELEGRAM_TOKEN_FILE" "Telegram token file")
	printf '%s\n' "$token" | grep -qE '^[0-9]+:[A-Za-z0-9_-]{30,}$' || {
		echo "hermes-gateway: invalid Telegram token" >&2; exit 1;
	}
	export TELEGRAM_BOT_TOKEN="$token"
fi

# The router MCP connection is optional. UCI owning it is not the same as it being
# reachable right now: a token file present when the instance was opened can go
# missing before a later respawn, and that must drop the connection quietly rather
# than take the whole gateway down with it. Telegram, above, stays fatal.
mcp_effective=""
if [ -n "${HERMES_OPENWRT_MCP_URL:-}" ]; then
	if token=$(read_required "${HERMES_MCP_TOKEN_FILE:-}" "router MCP token file" 2>/dev/null); then
		export OPENWRT_MCP_TOKEN="$token"
		mcp_effective="$HERMES_OPENWRT_MCP_URL"
	else
		echo "hermes-gateway: router MCP token file ${HERMES_MCP_TOKEN_FILE:-} is missing or empty; starting without the MCP connection" >&2
	fi
fi

# Further providers, from the UCI `provider` sections: procd holds their key FILES, the
# keys are read here into HERMES_PROVIDER_<NAME>_KEY, which the bridge names as each
# entry's key_env. A key that is missing drops that provider alone, with a line in the
# log, the same way the MCP connection above is dropped: the main model still answers.
for stale in $(env | sed -n 's/^\(HERMES_PROVIDER_[A-Z0-9_]*_KEY\)=.*/\1/p'); do
	unset "$stale"
done
providers_ready=""
if [ -n "${HERMES_OPENWRT_PROVIDERS:-}" ]; then
	set -f
	old_ifs=$IFS
	IFS=';'
	for entry in $HERMES_OPENWRT_PROVIDERS; do
		IFS='|' read -r p_name p_label p_url p_key_file p_model <<EOF
$entry
EOF
		if value=$(read_required "$p_key_file" "provider $p_name key file" 2>/dev/null); then
			export "HERMES_PROVIDER_$(printf '%s' "$p_name" | tr 'a-z-' 'A-Z_')_KEY=$value"
			providers_ready="$providers_ready;$entry"
		else
			echo "hermes-gateway: provider $p_name: key file $p_key_file is missing or empty; starting without it" >&2
		fi
	done
	IFS=$old_ifs
	set +f
fi

# UCI wins over whatever upstream's own runtime state persisted (a chat /model switch,
# for one), so the bridge is re-applied on every exec here, not only at the init's own
# first start. Requiredness is checked explicitly, ahead of time, rather than left to a
# failure deep inside the Python helper that would be harder to place.
: "${HERMES_HOME:?hermes-gateway: HERMES_HOME is required}"
: "${OPENAI_BASE_URL:?hermes-gateway: OPENAI_BASE_URL is required}"
: "${HERMES_MODEL:?hermes-gateway: HERMES_MODEL is required}"
: "${HERMES_OPENWRT_TOOLSETS?hermes-gateway: HERMES_OPENWRT_TOOLSETS is required}"
# Unset, same as a router upgraded from before profiles existed, means admin:
# the init's own default applies here too, not only at its first start.
HERMES_OPENWRT_PROVIDERS="${providers_ready#;}" PYTHONPATH=/usr/lib/hermes-agent/site-packages PYTHONDONTWRITEBYTECODE=1 /usr/bin/python3 /usr/libexec/hermes-set-toolsets "$HERMES_HOME" "$HERMES_OPENWRT_TOOLSETS" "$mcp_effective" "$OPENAI_BASE_URL" "$HERMES_MODEL" "${HERMES_OPENWRT_PROFILE:-admin}"

PYTHONPATH=/usr/lib/hermes-agent/site-packages \
	/usr/bin/python3 /usr/libexec/hermes-runtime-check
unset key token value HERMES_TELEGRAM_TOKEN_FILE HERMES_MCP_TOKEN_FILE HERMES_OPENWRT_TOOLSETS HERMES_OPENWRT_MCP_URL HERMES_OPENWRT_PROFILE HERMES_OPENWRT_MAX_TURNS HERMES_OPENWRT_PROVIDERS providers_ready entry p_name p_label p_url p_key_file p_model
exec /usr/bin/hermes gateway run --external-supervisor
