#!/bin/sh /etc/rc.common
# Hermes Agent under procd.
#
# Three things this script is responsible for, none of which the agent does for itself:
#
#   1. Refusing to start when the configuration cannot work. A gateway that boots with
#      no key and no model spends its life logging the same failure, and on a router
#      nobody is watching the log. Better to say why once and stay down.
#   2. Keeping secrets out of the process table and out of UCI. Keys are read from
#      root-only files and handed over as environment variables, so `ps` shows nothing
#      and `uci show` shows nothing.
#   3. Putting a ceiling on memory. Upstream's gateway is known to grow its RSS over
#      long uptimes; on a server that is an annoyance, on a 1 GB router it is the whole
#      box. The exec wrapper applies and verifies the cgroup ceiling before launch.

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/hermes
NAME=hermes-agent
CONF=/etc/hermes-agent
# Which profile means which account: shared with the exec wrapper, which does the drop.
. /usr/lib/hermes-agent/hermes-profile
# Runs a command as another user having given up root; see its own header.
DROP="/usr/bin/python3 -I -B /usr/libexec/hermes-drop"

# openwrt-mcp: the owner profile's whole way to the router. The agent reads through it and
# changes through it, and it runs as root and decides. The package manages one client per
# agent, hermes-<agent>, and its policies in sections named hermes_<agent>_*, and touches
# no other section of /etc/config/openwrt-mcp.
MCP_BIN=/usr/bin/openwrt-mcp
MCP_URL_DEFAULT=http://127.0.0.1:8730/mcp
# What a ubus_call may read without an unlock, one name per method, never a glob over a
# whole object: `system.*` would take in `system.reboot`. Names read off the 25.12.4 rootfs
# (procd's system object, netifd's, rpcd's iwinfo and luci-rpc, odhcpd's dhcp); a name an
# installed system does not have grants nothing. network.wireless is left out, because its
# status carries the radio configuration, keys included. The same list goes to the gateway
# (HERMES_OPENWRT_READ_UBUS), where the unlock plugin uses it to tell a read from a change when
# it refuses a scheduled job's changes: one list, so the two cannot disagree.
MCP_READ_UBUS='system.board system.info network.interface.dump network.interface.*.status network.device.status iwinfo.devices iwinfo.info iwinfo.assoclist dhcp.ipv6leases luci-rpc.getDHCPLeases luci-rpc.getHostHints luci-rpc.getNetworkDevices'
# What uci_get may read from a daemon that does not say it redacts: not wireless, whose keys
# would go to the model provider, and not the whole of network either, since a router running
# WireGuard keeps its private key in a network section. The default interfaces and the globals
# are named instead. openwrt-mcp matches a scope with path.Match, so `network.lan*` covers the
# section and its options.
MCP_READ_UCI='system system.* dhcp dhcp.* firewall firewall.* network.loopback* network.globals* network.lan* network.wan*'
# What uci_get may read from a daemon that reports uci_get_redacts_credentials (openwrt-mcp
# 0.5.0.2 and later): every uci_get answer then has each secret option (a Wi-Fi key, a WireGuard
# private or preshared key, a password, a RADIUS secret...) replaced by '<redacted>', for every
# client and with no way to turn it off, so wireless and the whole of network can be read, which
# is what setting up a guest Wi-Fi needs. ubus's network.wireless status is NOT redacted by the
# daemon and stays out of MCP_READ_UBUS whatever this says. See mcp_daemon_caps.
MCP_READ_UCI_WIDE='system system.* dhcp dhcp.* firewall firewall.* network network.* wireless wireless.*'
# What a ubus_call may change once the owner has unlocked: settings, the VPN and services, never a
# command, a file, a firmware or a package. Settings themselves go through uci_apply, which arms a
# rollback; these are the calls that bring a changed setting into effect. netifd: reload and restart
# the network, bring an interface up, down or renew its lease (the VPN is an interface), by the
# network.interface object or the interface's own, and
# reconfigure the Wi-Fi; rpcd's rc.init: start, stop, restart, reload, enable or disable a service
# that already has an init script. Names only, no glob that ends a whole object: openwrt-mcp
# matches with path.Match, so `network.interface.*.up` covers `network.interface.wg0.up` and
# nothing outside network.interface. Deliberately NOT here, in this or any policy the package
# writes: file.* (rpcd's file object runs commands and writes files), system.sysupgrade and
# system.validate_firmware_image (a firmware), system.reboot (a reboot cannot be rolled back),
# system.signal (kills any process), uci.* (a change over ubus would bypass uci_apply's checks and
# its rollback), service.* (procd's service.set starts any command as a service), rpc-sys.* (its
# package and upgrade methods), luci.* and luci-rpc.setInitAction. @claude 2026-10-08, 0.21.5-r11.
MCP_CHANGE_UBUS='network.reload network.restart network.interface.up network.interface.down network.interface.renew network.interface.*.up network.interface.*.down network.interface.*.renew network.wireless.up network.wireless.down network.wireless.reconf rc.init'

# Read a secret from a file into stdout, or nothing if it is missing or empty.
# Never echoes the path's contents to the log.
read_secret() {
	[ -n "$1" ] && [ -r "$1" ] && head -n1 "$1" | tr -d ' \t\r\n'
}

# The version the openwrt-mcp answering at <listen> gives for itself on /health, or nothing.
mcp_live_version() {
	wget -q -T 3 -O - "http://$1/health" 2>/dev/null | sed -n '1s/^openwrt-mcp \([^ ]*\) ok$/\1/p'
}

# What the openwrt-mcp that will answer this agent guarantees, printed on stdout as words:
# `redacts` when its status reports uci_get_redacts_credentials (wireless and the whole of network
# may then be read), `noexec` when it reports uci_apply_refuses_code_exec (a change policy may then
# be written: an apply that would make the router run code as root, a firewall include or a
# dnsmasq dhcpscript among them, is refused for every client). One line on stderr for each that is
# missing and matters. Fail closed: a status that does not answer, does not parse or lacks a key
# (a binary from before 0.5.0.2, or 0.5.0.3, has none) is a guarantee not given.
#
# `openwrt-mcp status` is the INSTALLED binary speaking: it reports its own capabilities and
# whether something at its listen address answers /health as openwrt-mcp. apk replaces the binary
# on an upgrade without restarting the daemon (openwrt-mcp's package restarts it on an install
# only), so a daemon from before the upgrade, which guarantees nothing, can still be the one
# serving. So when one is running, the version its /health gives must be the installed binary's;
# when it is not, the daemon is restarted once, and if it still is not (or cannot be read), no
# guarantee holds. A daemon that is not running is started from the installed binary further down.
#   mcp_daemon_caps <factor>
mcp_daemon_caps() {
	local factor=$1 st redacts noexec ver running listen live i caps=""
	st=$("$MCP_BIN" status --json --audit 0 2>/dev/null)
	redacts=$(printf '%s' "$st" | jsonfilter -e '@.capabilities.uci_get_redacts_credentials' 2>/dev/null)
	noexec=$(printf '%s' "$st" | jsonfilter -e '@.capabilities.uci_apply_refuses_code_exec' 2>/dev/null)
	ver=$(printf '%s' "$st" | jsonfilter -e '@.version' 2>/dev/null)
	running=$(printf '%s' "$st" | jsonfilter -e '@.running' 2>/dev/null)
	if [ "$running" = true ] && { [ "$redacts" = true ] || [ "$noexec" = true ]; }; then
		listen=$(printf '%s' "$st" | jsonfilter -e '@.listen' 2>/dev/null)
		listen=${listen:-127.0.0.1:8730}
		live=$(mcp_live_version "$listen")
		if [ "$live" != "$ver" ]; then
			/etc/init.d/openwrt-mcp restart >/dev/null 2>&1
			i=0
			while [ "$i" -lt 10 ]; do
				live=$(mcp_live_version "$listen")
				[ "$live" != "$ver" ] || break
				i=$((i + 1)); sleep 1
			done
		fi
		if [ "$live" != "$ver" ]; then
			echo "$NAME: the openwrt-mcp running is ${live:-of unknown version}, not the installed $ver that redacts credentials and refuses code execution, and a restart did not change that; until 'service openwrt-mcp restart' does, the agent may not read wireless or the whole of network, and nothing can change the router through it" >&2
			return 0
		fi
	fi
	if [ "$redacts" = true ]; then
		caps=redacts
	else
		echo "$NAME: openwrt-mcp ${ver:-(no status)} does not report that uci_get redacts credentials, so the agent may not read wireless or the whole of network; openwrt-mcp 0.5.0.2 or later does" >&2
	fi
	if [ "$noexec" = true ]; then
		caps="$caps noexec"
	elif [ "$factor" != none ]; then
		echo "$NAME: openwrt-mcp ${ver:-(no status)} does not report that uci_apply refuses code execution, so no change policy is written and nothing can change the router through the agent, whatever the factor; openwrt-mcp 0.5.0.3 or later does" >&2
	fi
	echo $caps
}

# The agent reaches its data directory through every directory above it, and one that only
# root may enter ends a start with "cannot write in <data dir>", which sends the reader to the
# wrong place. This names the directory that stands in the way, and its mode, and leaves it
# alone: the mode of a directory this script did not make is not this script's to change.
# One run as the agent's user walks every ancestor; if that run itself cannot be made, nothing
# is said here and the write test in hand_over_data_dir still stops the start.
check_agent_can_reach() {
	local dir=$1 user=$2 blocked mode
	[ "$user" != root ] || return 0
	blocked=$($DROP "$user" /bin/sh -c 'p=$1; while [ "$p" != / ] && [ "$p" != . ]; do p=$(dirname "$p"); [ -x "$p" ] || { echo "$p"; exit 1; }; done' sh "$dir" 2>/dev/null)
	[ -n "$blocked" ] || return 0
	set -- $(ls -ld "$blocked")
	mode=$1
	echo "$NAME: '$user' cannot enter $blocked ($mode), which is above the data directory $dir." >&2
	echo "$NAME: 'chmod 755 $blocked' opens it (this script leaves the mode of a directory that already exists alone), or point data_dir somewhere the agent can reach." >&2
	return 1
}

# The data directory belongs to the user the agent runs as, so what the agent writes there
# it can write again, and what an earlier release (which ran as root) wrote there is still
# readable. Handed over only when the directory's own owner differs, not on every start: a
# walk of a database that only grows is a cost the first start after an upgrade pays once.
# -h so a symlink inside it is chowned as itself and never as whatever it points at.
hand_over_data_dir() {
	local dir=$1 user=$2 uid gid owner
	check_agent_can_reach "$dir" "$user" || return 1
	uid=$(id -u "$user" 2>/dev/null) && gid=$(id -g "$user" 2>/dev/null) || {
		echo "$NAME: there is no user '$user'; reinstall hermes-agent so its post-install script creates it" >&2
		return 1; }
	set -- $(ls -ldn "$dir")
	owner=$3
	if [ "$owner" != "$uid" ]; then
		echo "$NAME: giving $dir to '$user'; it belonged to uid $owner, and what is in it is kept" >&2
		chown -hR "$uid:$gid" "$dir" || {
			echo "$NAME: cannot give $dir to '$user'" >&2; return 1; }
	fi
	# Whatever the filesystem says, the agent must be able to write there: a FAT or NTFS
	# stick takes chown without error and ignores it.
	if [ "$user" != root ] && ! $DROP "$user" /bin/sh -c ': > "$1/.hermes-write-test" && rm -f "$1/.hermes-write-test"' sh "$dir" 2>/dev/null; then
		echo "$NAME: '$user' cannot write in $dir. The profile needs a data_dir on a filesystem with" >&2
		echo "$NAME: Unix ownership (ext4, f2fs, the overlay), not FAT or NTFS; or choose the root profile." >&2
		return 1
	fi
}

# The UCI statements for one agent's policies, in the order openwrt-mcp has to see them:
# it takes the FIRST policy of a client that covers every scope of a call, so the narrow
# read grants come first, each tool in a policy of its own so that one tool's scope globs
# cannot widen another's, and the two change policies, which ask for the second factor on
# everything they grant, last: uci_apply and uci_confirm on any setting, each apply rolled back
# unless confirmed, and ubus_call on MCP_CHANGE_UBUS only. With no factor configured neither is
# written, so a change finds no policy at all ("no policy grants").
# Nor is either written when the daemon does not refuse an apply that runs code (may_change no).
#   mcp_policy_batch <client> <section prefix> <factor> <window> <max failures> <lockout> <uci scopes> <may change>
mcp_policy_batch() {
	local client=$1 prefix=$2 factor=$3 window=$4 max_failures=$5 lockout=$6 read_uci=$7 may_change=$8 scope
	set -f
	printf 'set openwrt-mcp.%sread_ubus=policy\nset openwrt-mcp.%sread_ubus.client=%s\nadd_list openwrt-mcp.%sread_ubus.tools=ubus_call\n' "$prefix" "$prefix" "$client" "$prefix"
	for scope in $MCP_READ_UBUS; do printf "add_list openwrt-mcp.%sread_ubus.scopes='%s'\n" "$prefix" "$scope"; done
	printf 'set openwrt-mcp.%sread_uci=policy\nset openwrt-mcp.%sread_uci.client=%s\nadd_list openwrt-mcp.%sread_uci.tools=uci_get\n' "$prefix" "$prefix" "$client" "$prefix"
	for scope in $read_uci; do printf "add_list openwrt-mcp.%sread_uci.scopes='%s'\n" "$prefix" "$scope"; done
	printf 'set openwrt-mcp.%sread_log=policy\nset openwrt-mcp.%sread_log.client=%s\nadd_list openwrt-mcp.%sread_log.tools=logread\n' "$prefix" "$prefix" "$client" "$prefix"
	set +f
	[ "$factor" = none ] && return 0
	[ "$may_change" = yes ] || return 0
	local tool sect
	printf 'set openwrt-mcp.%schange=policy\nset openwrt-mcp.%schange.client=%s\n' "$prefix" "$prefix" "$client"
	# Not wg_new_client: its answer is a WireGuard peer's private key, and what a tool answers
	# goes to the model provider. An owner who wants it grants it in a policy of their own.
	for tool in uci_apply uci_confirm; do printf 'add_list openwrt-mcp.%schange.tools=%s\n' "$prefix" "$tool"; done
	printf "add_list openwrt-mcp.%schange.scopes='*'\n" "$prefix"
	printf 'set openwrt-mcp.%schange_ubus=policy\nset openwrt-mcp.%schange_ubus.client=%s\nadd_list openwrt-mcp.%schange_ubus.tools=ubus_call\n' "$prefix" "$prefix" "$client" "$prefix"
	set -f
	for scope in $MCP_CHANGE_UBUS; do printf "add_list openwrt-mcp.%schange_ubus.scopes='%s'\n" "$prefix" "$scope"; done
	set +f
	# Both ask the factor for all they grant, with the same settings: openwrt-mcp unlocks per
	# client, and refuses a client whose gating policies disagree.
	for sect in change change_ubus; do
		printf "add_list openwrt-mcp.%s%s.mfa_tools='*'\n" "$prefix" "$sect"
		printf 'set openwrt-mcp.%s%s.mfa_factor=%s\nset openwrt-mcp.%s%s.mfa_window=%s\nset openwrt-mcp.%s%s.mfa_max_failures=%s\nset openwrt-mcp.%s%s.mfa_lockout=%s\n' \
			"$prefix" "$sect" "$factor" "$prefix" "$sect" "$window" "$prefix" "$sect" "$max_failures" "$prefix" "$sect" "$lockout"
	done
}

# Make /etc/config/openwrt-mcp hold exactly the policies this package owns for one agent.
# What the package wrote is compared with what it would write, by building the desired
# sections in a scratch config and comparing `uci show` of both, so a start that changes
# nothing writes nothing to flash. When they differ the package's sections for that agent
# are deleted and written again, in order, which also puts them after any older ones.
mcp_policies() {
	local client=$1 agent=$2 factor=$3 window=$4 max_failures=$5 lockout=$6 read_uci=$7 may_change=$8
	local prefix="hermes_${agent}_" scratch want have sect
	scratch=$(mktemp -d /tmp/hermes-mcp.XXXXXX) || return 1
	: > "$scratch/openwrt-mcp"
	mcp_policy_batch "$client" "$prefix" "$factor" "$window" "$max_failures" "$lockout" "$read_uci" "$may_change" > "$scratch/batch"
	uci -c "$scratch" -P "$scratch/save" -q batch < "$scratch/batch" && uci -c "$scratch" -P "$scratch/save" -q commit openwrt-mcp || {
		rm -rf "$scratch"; echo "$NAME: could not build the openwrt-mcp policies for $client" >&2; return 1; }
	want=$(uci -c "$scratch" -P "$scratch/save" -q show openwrt-mcp | grep "^openwrt-mcp\.$prefix")
	have=$(uci -q show openwrt-mcp | grep "^openwrt-mcp\.$prefix")
	if [ "$want" != "$have" ]; then
		[ -e /etc/config/openwrt-mcp ] || : > /etc/config/openwrt-mcp
		for sect in $(uci -q show openwrt-mcp | sed -n "s/^openwrt-mcp\.\($prefix[a-z_]*\)=.*/\1/p"); do
			uci -q delete "openwrt-mcp.$sect"
		done
		uci -q batch < "$scratch/batch" && uci -q commit openwrt-mcp || {
			uci -q revert openwrt-mcp; rm -rf "$scratch"
			echo "$NAME: could not write the openwrt-mcp policies for $client" >&2; return 1; }
	fi
	rm -rf "$scratch"
}

# One agent's way to the router: its own paired client and token, and its own policies.
#   hermes_mcp_agent <agent> <token file> <factor> <window> <max failures> <lockout>
# The token is made only when the file is missing or empty, by `openwrt-mcp pair`, into a
# root-only file; an earlier token for the same client is revoked first, because nobody
# holds it any more. Unlocking is per client, so a second agent added later is
# hermes-<name> with its own token and its own unlock window.
hermes_mcp_agent() {
	local agent=$1 token_file=$2 factor=$3 window=$4 max_failures=$5 lockout=$6
	local client="hermes-$agent" tmp tok read_uci caps may_change
	case "$agent" in ''|*[!a-z0-9]*) echo "$NAME: agent name '$agent' must be lower-case letters and digits" >&2; return 1 ;; esac
	[ -x "$MCP_BIN" ] || {
		echo "$NAME: openwrt-mcp is not installed ($MCP_BIN); apk add openwrt-mcp" >&2; return 1; }
	if [ -z "$(read_secret "$token_file")" ]; then
		tmp="$token_file.new"
		rm -f "$tmp"
		"$MCP_BIN" unpair "$client" >/dev/null 2>&1
		( umask 077; "$MCP_BIN" pair "$client" > "$tmp" ) 2>/dev/null
		tok=$(head -n1 "$tmp" 2>/dev/null | tr -d ' \t\r\n')
		if [ -z "$tok" ]; then
			rm -f "$tmp"
			echo "$NAME: could not pair $client with openwrt-mcp" >&2
			return 1
		fi
		chmod 0600 "$tmp" && mv "$tmp" "$token_file" || return 1
		echo "$NAME: paired $client with openwrt-mcp; its token is in $token_file" >&2
	fi
	# Wireless and the whole of network only from a daemon that redacts every secret in them, and
	# a change policy only from one that refuses an apply that would run code.
	caps=" $(mcp_daemon_caps "$factor") "
	case "$caps" in *" redacts "*) read_uci=$MCP_READ_UCI_WIDE ;; *) read_uci=$MCP_READ_UCI ;; esac
	case "$caps" in *" noexec "*) may_change=yes ;; *) may_change=no ;; esac
	mcp_policies "$client" "$agent" "$factor" "$window" "$max_failures" "$lockout" "$read_uci" "$may_change"
}

start_service() {
	local enabled data_dir base_url model key_file mem_max respawn
	local mcp_url mcp_token_file key profile profile_set run_user max_turns
	local sec_factor sec_window sec_max sec_lockout v
	local toolsets providers providers_bad
	local tg_on tg_token_file tg_token tg_allow_all tg_home tg_allow
	# tg_allow and toolsets are declared here and filled by the append_* helpers
	# below. ash gives `local` dynamic scope, so a helper called from here sees and
	# modifies this variable; leaving either one out would make it a global that
	# accumulates across a restart in the same shell.

	config_load hermes
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || {
		echo "$NAME: disabled in /etc/config/hermes; not starting" >&2
		return 0
	}

	config_get data_dir       main data_dir '/srv/hermes'
	config_get base_url       main base_url ''
	config_get model          main model ''
	config_get key_file       main key_file "$CONF/provider.key"
	config_get mem_max        main mem_max_mb '512'
	config_get_bool respawn   main respawn 1
	config_get mcp_url        main router_mcp_url ''
	config_get mcp_token_file main router_mcp_token_file ''
	config_get profile_set    main profile ''
	config_get max_turns      main max_turns '20'

	key=$(read_secret "$key_file")

	# Three profiles, chosen in /etc/config/hermes, and one old name. owner (what applies
	# wherever none is set, existing routers included) runs the agent as the unprivileged
	# user hermes with every selected tool, and it changes the router only through
	# openwrt-mcp, which wants the owner's unlock; assistant runs as hermes too, with
	# terminal, code execution and file tools off whatever toolsets below selects; root
	# runs as root with every selected tool and no unlock, and is warned about every time.
	# admin is the old name of root. Refuse rather than guess what a fourth value meant,
	# the same way an unusable base_url or model refuses below.
	profile=$(hermes_profile_canonical "${profile_set:-owner}") || {
		echo "$NAME: hermes.main.profile in /etc/config/hermes must be 'owner', 'assistant' or 'root', not '$profile_set'" >&2
		return 1
	}
	run_user=$(hermes_profile_user "$profile")
	case "$profile" in
		owner)
			if [ -z "$profile_set" ]; then
				echo "$NAME: profile 'owner' (none is set, so this is the default): the agent runs as the unprivileged user 'hermes'; before 0.21.5-r3 an unset profile ran as root. 'uci set hermes.main.profile=root && uci commit hermes && service hermes-agent restart' keeps that." >&2
			else
				echo "$NAME: profile 'owner': the agent runs as the unprivileged user 'hermes'. It reads the router through openwrt-mcp and changes it only there, once you unlock it." >&2
			fi
			;;
		assistant)
			echo "$NAME: profile 'assistant': the agent runs as the unprivileged user 'hermes'; terminal, code execution and file tools are off. 'uci set hermes.main.profile=owner && uci commit hermes && service hermes-agent restart' allows them." >&2
			;;
		root)
			[ "$profile_set" != admin ] || echo "$NAME: profile 'admin' is the old name of 'root'." >&2
			echo "$NAME: profile 'root': the agent runs as root on this router. Its terminal, file and code tools can change anything on it with no unlock, whatever openwrt-mcp is set to. 'uci set hermes.main.profile=owner && uci commit hermes && service hermes-agent restart' goes back to the unprivileged user." >&2
			;;
	esac

	# The second factor the owner unlocks changes with, and how long and how often. Only the
	# owner profile has one. "none" is the default, and means nothing can change the router
	# until the owner sets a factor: no change policy is written at all.
	sec_factor=none
	if [ "$profile" = owner ]; then
		config_get sec_factor   security factor 'none'
		config_get sec_window   security window '15m'
		config_get sec_max      security max_failures '5'
		config_get sec_lockout  security lockout '15m'
		case "$sec_factor" in
			none|pin|totp|pin+totp) ;;
			*) echo "$NAME: hermes.security.factor must be none, pin, totp or pin+totp, not '$sec_factor'" >&2; return 1 ;;
		esac
		for v in "$sec_window" "$sec_lockout"; do
			echo "$v" | grep -Eq '^([0-9]+(\.[0-9]+)?(s|m|h))+$|^[0-9]+(\.[0-9]+)?d$' || {
				echo "$NAME: hermes.security window and lockout are durations such as 15m, 1h or 1d, not '$v'" >&2; return 1; }
		done
		case "$sec_max" in ''|*[!0-9]*|0) echo "$NAME: hermes.security.max_failures must be a whole number of at least 1, not '$sec_max'" >&2; return 1 ;; esac
	fi

	# Refuse rather than flap. Each branch names the one thing to fix, because the
	# person reading this in logread has no other source of truth.
	[ -n "$base_url" ] || { echo "$NAME: base_url is empty in /etc/config/hermes" >&2; return 1; }
	[ -n "$model" ]    || { echo "$NAME: model is empty in /etc/config/hermes" >&2; return 1; }
	if [ -z "$key" ]; then
		echo "$NAME: no API key in $key_file. Write the key there as a single line:" >&2
		echo "$NAME:   printf '%s' 'sk-...' > $key_file && chmod 600 $key_file" >&2
		return 1
	fi

	# ---- Telegram: the refusals ----
	#
	# Upstream enables the platform on the mere presence of TELEGRAM_BOT_TOKEN in the
	# environment (gateway/config.py: `if telegram_token: _enable_from_env(...)`). So
	# there is nothing to switch on, only a decision about whether to hand the token
	# over, and this half is the four ways the answer is no.
	#
	# They sit here, with the other refusals, rather than beside the export below: a
	# refusal after procd_open_instance leaves a half-built instance behind, and more to
	# the point a router logs to a screen nobody reads, so each branch names the single
	# thing to fix and stays down until it is fixed.
	config_get_bool tg_on   telegram enabled 0
	if [ "$tg_on" -eq 1 ]; then
		config_get tg_token_file  telegram token_file "$CONF/telegram.token"
		config_get_bool tg_allow_all telegram allow_all 0
		config_get tg_home        telegram home_channel ''

		# The library, not a python import: asking python costs a second of a slow core
		# at every start, and the add-on package ships a manifest whose presence is the
		# same fact. See package/hermes-agent-telegram.
		if [ ! -f /usr/lib/hermes-agent/telegram.manifest ]; then
			echo "$NAME: telegram is enabled but its client library is not installed." >&2
			echo "$NAME:   apk add hermes-agent-telegram" >&2
			return 1
		fi

		tg_token=$(read_secret "$tg_token_file")
		if [ -z "$tg_token" ]; then
			echo "$NAME: telegram is enabled but there is no token in $tg_token_file." >&2
			echo "$NAME: get one from @BotFather and write it as a single line:" >&2
			echo "$NAME:   printf '%s' '123456:ABC...' > $tg_token_file && chmod 600 $tg_token_file" >&2
			return 1
		fi

		# Telegram's own token shape, the same one upstream's web UI validates against.
		# Catching a truncated paste here costs nothing; catching it at the API costs a
		# confused half hour reading a 401 that says nothing about the cause.
		if ! echo "$tg_token" | grep -qE '^[0-9]+:[A-Za-z0-9_-]{30,}$'; then
			echo "$NAME: the token in $tg_token_file is not shaped like a Telegram token" >&2
			echo "$NAME: (digits, a colon, then at least 30 more characters)." >&2
			return 1
		fi

		tg_allow=""
		config_list_foreach telegram allow_user_id append_allow_user

		# Upstream default-denies an unlisted user, so an empty allowlist is SAFE and
		# useless: the bot answers nobody and says nothing about why. Refusing here
		# turns a silent misconfiguration into one line in logread. allow_all exists
		# because it is upstream's own escape hatch, and it is spelled out rather than
		# implied so nobody reaches it by leaving a list empty.
		if [ -z "$tg_allow" ] && [ "$tg_allow_all" -ne 1 ]; then
			echo "$NAME: telegram is enabled but no user is allowed to talk to it." >&2
			echo "$NAME: add your numeric Telegram id (ask @userinfobot for it):" >&2
			echo "$NAME:   uci add_list hermes.telegram.allow_user_id=123456789" >&2
			echo "$NAME:   uci commit hermes && service hermes-agent restart" >&2
			echo "$NAME: or set hermes.telegram.allow_all=1 to answer anyone, which on a" >&2
			echo "$NAME: bot holding router tools means anyone who finds the bot." >&2
			return 1
		fi
	fi

	# Data moved to a USB stick by hermes-usb: start only on that stick. Without it the
	# directory underneath is the router's own storage, and an agent starting there empty
	# would write exactly where the owner chose not to. So this stops the start and says
	# why, before anything below can create or hand over a directory. The gateway wrapper
	# asks the same before every respawn, and the block hotplug script starts the service
	# when the stick appears, so a stick that is late at boot needs no wait here.
	. /usr/lib/hermes-agent/hermes-usb-check
	local why
	why=$(hermes_data_ok "$data_dir") || { echo "$NAME: $why. Not starting." >&2; return 1; }

	# The data directory is deliberately not created on the overlay by default. If it
	# is missing we make it, but a router whose overlay is a few megabytes should have
	# data_dir pointed at external storage instead, and this is where that gets said.
	if [ ! -d "$data_dir" ]; then
		# The parents are made with a umask of 022 and the directory itself with 077, whatever
		# the umask this script was started with: a boot starts it with one that makes `mkdir -p`
		# create every missing parent closed to everyone but root, and the agent's user then cannot
		# enter /srv to reach its own directory. Measured 2026-10-02 in a QEMU OpenWrt 25.12.5
		# that had no /srv; the test routers had one already. A parent that exists is not touched.
		( umask 022; mkdir -p "$(dirname "$data_dir")" ) 2>/dev/null && ( umask 077; mkdir "$data_dir" ) 2>/dev/null || {
			echo "$NAME: cannot create $data_dir" >&2; return 1; }
		echo "$NAME: created $data_dir on the root filesystem. Sessions and memory grow" >&2
		echo "$NAME: without bound; move data_dir to external storage if space is tight." >&2
	fi
	chmod 0700 "$data_dir" 2>/dev/null
	hand_over_data_dir "$data_dir" "$run_user" || return 1

	# The owner profile's connection to the router. Its URL is openwrt-mcp's own loopback
	# address unless UCI says otherwise (an option set to nothing turns the connection off),
	# its token is paired here the first time, and its policies are written here, every
	# start, from hermes.security. A daemon that cannot be reached costs the agent its
	# router tools and not the service, like a missing token (invariant 3).
	if [ "$profile" = owner ]; then
		[ -n "$mcp_token_file" ] || mcp_token_file="$CONF/router-mcp.token"
		if [ -z "$mcp_url" ] && ! uci -q get hermes.main.router_mcp_url >/dev/null 2>&1; then
			mcp_url=$MCP_URL_DEFAULT
		fi
		if [ -n "$mcp_url" ]; then
			if hermes_mcp_agent main "$mcp_token_file" "$sec_factor" "$sec_window" "$sec_max" "$sec_lockout"; then
				/etc/init.d/openwrt-mcp enable >/dev/null 2>&1
				/etc/init.d/openwrt-mcp running >/dev/null 2>&1 || /etc/init.d/openwrt-mcp start >/dev/null 2>&1 \
					|| echo "$NAME: could not start openwrt-mcp; the agent has no router tools until it runs" >&2
			else
				mcp_url=""
			fi
		fi
	fi

	# @codex 2026-09-19: validate and persist the actual gateway contract before
	# opening any procd instance. A bad selection must never fall back to defaults.
	if [ -n "$mcp_url" ] && [ -z "$(read_secret "$mcp_token_file")" ]; then
		echo "$NAME: MCP token unavailable; starting without the UCI MCP connection" >&2
		mcp_url=""
	fi
	toolsets=""
	config_list_foreach main toolsets append_toolset
	# Further providers, one UCI `provider` section each. Names, endpoints, models and
	# key-file PATHS only: the keys themselves are read by the wrapper at exec, like the
	# main key. The bridge below validates them and refuses the start on a bad one.
	# config_foreach carries on past a failing callback and returns only the last
	# one's status, so a bad section anywhere but last would slip through without this.
	providers=""
	providers_bad=""
	config_foreach append_provider provider
	[ -z "$providers_bad" ] || return 1
	# As the user the agent runs as, like the wrapper's own run of it: it writes the agent's
	# configuration, and a file written here as root would be one the agent cannot update.
	HERMES_HOME="$data_dir" PYTHONPATH=/usr/lib/hermes-agent/site-packages \
		HERMES_OPENWRT_MAX_TURNS="$max_turns" \
		HERMES_OPENWRT_FACTOR="$sec_factor" \
		HERMES_OPENWRT_PROVIDERS="${providers#;}" \
		PYTHONDONTWRITEBYTECODE=1 $DROP "$run_user" /usr/bin/python3 /usr/libexec/hermes-set-toolsets \
		"$data_dir" "${toolsets#,}" "$mcp_url" "$base_url" "$model" "$profile" || return 1

	procd_open_instance
	# --external-supervisor, because procd IS one. Without it an in-chat restart or
	# update spawns a detached replacement that escapes procd, and the router ends up
	# with a gateway procd neither supervises nor can stop.
	# The key is read by a wrapper at exec time rather than handed to procd, so it
	# appears in neither argv nor procd's service table. See below.
	procd_set_param command /usr/sbin/hermes-gateway "$key_file"

	# Everything here is non-secret, so procd may hold it. The key is deliberately
	# absent: procd hands its whole env block back through
	#   ubus call service list '{"name":"hermes-agent"}'
	# which rpcd ACLs can expose to a LuCI session, so a secret placed here is readable
	# well beyond root. Found on hardware on 2026-09-13, after argv and uci had been
	# clean for months. -> check_key_not_in_procd_env
	procd_set_param env \
		HERMES_HOME="$data_dir" \
		HERMES_DISABLE_LAZY_INSTALLS=1 \
		PYTHONDONTWRITEBYTECODE=1 \
		OPENAI_BASE_URL="$base_url" \
		HERMES_MODEL="$model" \
		HERMES_MEM_MAX_MB="$mem_max" \
		HERMES_OPENWRT_TOOLSETS="${toolsets#,}" \
		HERMES_OPENWRT_MCP_URL="$mcp_url" \
		HERMES_OPENWRT_PROFILE="$profile" \
		HERMES_OPENWRT_FACTOR="$sec_factor" \
		HERMES_OPENWRT_READ_UBUS="$(printf '%s' "$MCP_READ_UBUS" | tr ' ' ',')" \
		HERMES_OPENWRT_MAX_TURNS="$max_turns" \
		HERMES_OPENWRT_PROVIDERS="${providers#;}"

	# HERMES_DISABLE_LAZY_INSTALLS is not optional here. Left unset, Hermes pip-installs
	# missing pieces at runtime, and a router has no compiler, often no free space, and
	# sometimes no route to PyPI. Upstream's own container image sets it for the same
	# reason.
	#
	# PYTHONDONTWRITEBYTECODE=1 because the package already ships every .pyc, compiled at
	# build time, so the router never needs to parse and never needs to write. Leaving
	# writing on is not merely redundant, it is harmful: any module that arrived without
	# its bytecode gets one written into the package's own directory, apk does not own
	# that file, and `apk del` then leaves the whole tree behind. A teeth run found
	# exactly that on 2026-09-08, from a package deliberately built with one .pyc
	# missing.

	[ -n "$mcp_url" ] && procd_append_param env HERMES_MCP_TOKEN_FILE="$mcp_token_file"

	# ---- Telegram: the export half ----
	# Validated above, before any procd state was touched. Only the handover is left,
	# and it has to be here because procd_append_param needs an open instance.
	if [ "$tg_on" -eq 1 ]; then
		procd_append_param env HERMES_TELEGRAM_TOKEN_FILE="$tg_token_file"
		[ -n "$tg_allow" ] && procd_append_param env TELEGRAM_ALLOWED_USERS="${tg_allow#,}"
		[ "$tg_allow_all" -eq 1 ] && procd_append_param env TELEGRAM_ALLOW_ALL_USERS=true
		[ -n "$tg_home" ] && procd_append_param env TELEGRAM_HOME_CHANNEL="$tg_home"
	fi

	[ "$respawn" -eq 1 ] && procd_set_param respawn 3600 5 5
	procd_set_param limits core="0"
	# The router's own work keeps the processor. Measured 2026-09-24 on a Brume 2
	# carrying a WireGuard tunnel: a conversation at the default priority took a third
	# of the tunnel's throughput while it ran, at nice 10 a quarter. Inherited by the
	# gateway the wrapper execs and by every tool process it starts.
	procd_set_param nice 10

	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile /var/run/$NAME.pid
	procd_close_instance
}

append_toolset() {
	toolsets="$toolsets,$1"
}

append_provider() {
	local section=$1 on label url key_file model field
	config_get_bool on "$section" enabled 1
	[ "$on" -eq 1 ] || return 0
	config_get label    "$section" label "$section"
	config_get url      "$section" base_url ''
	config_get key_file "$section" key_file "$CONF/$section.key"
	config_get model    "$section" model ''
	[ -n "$url" ] && [ -n "$model" ] || {
		echo "$NAME: provider '$section' needs base_url and model in /etc/config/hermes" >&2
		providers_bad=1
		return 0
	}
	# The list is carried as name|label|base_url|key_file|model;... so neither
	# character may appear inside a field.
	for field in "$section" "$label" "$url" "$key_file" "$model"; do
		case "$field" in *'|'*|*';'*)
			echo "$NAME: provider '$section': '|' and ';' are not allowed in its settings" >&2
			providers_bad=1
			return 0 ;;
		esac
	done
	providers="$providers;$section|$label|$url|$key_file|$model"
}

append_allow_user() {
	# Numeric ids only. A username here would be accepted by nothing downstream and
	# would look, in uci show, exactly like a working allowlist.
	case "$1" in
		''|*[!0-9]*) echo "$NAME: ignoring allow_user_id '$1': not a numeric Telegram id" >&2 ;;
		*) tg_allow="$tg_allow,$1" ;;
	esac
}

service_triggers() {
	procd_add_reload_trigger "hermes"
}

reload_service() {
	# Every setting this script reads is turned into an environment variable or an
	# argument at start time, so there is nothing a running process would pick up.
	restart
}

stop_service() {
	return 0
}
