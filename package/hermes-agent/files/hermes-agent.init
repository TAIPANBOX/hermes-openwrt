#!/bin/sh /etc/rc.common
# Hermes Agent under procd.
#
# Three things this script is responsible for, none of which the agent does for itself:
#
#   1. Refusing to start when the configuration cannot work. A gateway that boots with
#      no key and no model spends its life logging the same failure, and on a router
#      nobody is watching the log. Better to say why once and stay down.
#   2. Keeping secrets out of the process table and out of UCI. Keys are read from
#      root-only files and handed over as environment variables, so `ps` shows nothing
#      and `uci show` shows nothing.
#   3. Putting a ceiling on memory. Upstream's gateway is known to grow its RSS over
#      long uptimes; on a server that is an annoyance, on a 1 GB router it is the whole
#      box. The exec wrapper applies and verifies the cgroup ceiling before launch.

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/hermes
NAME=hermes-agent
CONF=/etc/hermes-agent

# Read a secret from a file into stdout, or nothing if it is missing or empty.
# Never echoes the path's contents to the log.
read_secret() {
	[ -n "$1" ] && [ -r "$1" ] && head -n1 "$1" | tr -d ' \t\r\n'
}

start_service() {
	local enabled data_dir base_url model key_file mem_max respawn
	local mcp_url mcp_token_file key profile max_turns
	local toolsets
	local tg_on tg_token_file tg_token tg_allow_all tg_home tg_allow
	# tg_allow and toolsets are declared here and filled by the append_* helpers
	# below. ash gives `local` dynamic scope, so a helper called from here sees and
	# modifies this variable; leaving either one out would make it a global that
	# accumulates across a restart in the same shell.

	config_load hermes
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || {
		echo "$NAME: disabled in /etc/config/hermes; not starting" >&2
		return 0
	}

	config_get data_dir       main data_dir '/srv/hermes'
	config_get base_url       main base_url ''
	config_get model          main model ''
	config_get key_file       main key_file "$CONF/provider.key"
	config_get mem_max        main mem_max_mb '512'
	config_get_bool respawn   main respawn 1
	config_get mcp_url        main router_mcp_url ''
	config_get mcp_token_file main router_mcp_token_file ''
	config_get profile        main profile 'admin'
	config_get max_turns      main max_turns '20'

	key=$(read_secret "$key_file")

	# Two profiles, chosen in /etc/config/hermes, not a spectrum: admin leaves every
	# selected tool in place, as root; assistant turns off terminal, code execution
	# and file tools regardless of what toolsets below selects, and tells the agent
	# so. Unset means admin, on every router including ones upgraded from before
	# this option existed. Refuse rather than guess what a third value
	# meant, the same way an unusable base_url or model refuses below.
	case "$profile" in
		assistant|admin) ;;
		*)
			echo "$NAME: hermes.main.profile in /etc/config/hermes must be 'assistant' or 'admin', not '$profile'" >&2
			return 1
			;;
	esac
	if [ "$profile" = assistant ]; then
		echo "$NAME: profile 'assistant': terminal, code execution and file tools are off. 'uci set hermes.main.profile=admin && uci commit hermes && service hermes-agent restart' allows them." >&2
	else
		echo "$NAME: profile 'admin': the agent can run commands and write files on this router as root." >&2
	fi

	# Refuse rather than flap. Each branch names the one thing to fix, because the
	# person reading this in logread has no other source of truth.
	[ -n "$base_url" ] || { echo "$NAME: base_url is empty in /etc/config/hermes" >&2; return 1; }
	[ -n "$model" ]    || { echo "$NAME: model is empty in /etc/config/hermes" >&2; return 1; }
	if [ -z "$key" ]; then
		echo "$NAME: no API key in $key_file. Write the key there as a single line:" >&2
		echo "$NAME:   printf '%s' 'sk-...' > $key_file && chmod 600 $key_file" >&2
		return 1
	fi

	# ---- Telegram: the refusals ----
	#
	# Upstream enables the platform on the mere presence of TELEGRAM_BOT_TOKEN in the
	# environment (gateway/config.py: `if telegram_token: _enable_from_env(...)`). So
	# there is nothing to switch on, only a decision about whether to hand the token
	# over, and this half is the four ways the answer is no.
	#
	# They sit here, with the other refusals, rather than beside the export below: a
	# refusal after procd_open_instance leaves a half-built instance behind, and more to
	# the point a router logs to a screen nobody reads, so each branch names the single
	# thing to fix and stays down until it is fixed.
	config_get_bool tg_on   telegram enabled 0
	if [ "$tg_on" -eq 1 ]; then
		config_get tg_token_file  telegram token_file "$CONF/telegram.token"
		config_get_bool tg_allow_all telegram allow_all 0
		config_get tg_home        telegram home_channel ''

		# The library, not a python import: asking python costs a second of a slow core
		# at every start, and the add-on package ships a manifest whose presence is the
		# same fact. See package/hermes-agent-telegram.
		if [ ! -f /usr/lib/hermes-agent/telegram.manifest ]; then
			echo "$NAME: telegram is enabled but its client library is not installed." >&2
			echo "$NAME:   apk add hermes-agent-telegram      # 25.12 and later" >&2
			echo "$NAME:   opkg install hermes-agent-telegram # 24.10" >&2
			return 1
		fi

		tg_token=$(read_secret "$tg_token_file")
		if [ -z "$tg_token" ]; then
			echo "$NAME: telegram is enabled but there is no token in $tg_token_file." >&2
			echo "$NAME: get one from @BotFather and write it as a single line:" >&2
			echo "$NAME:   printf '%s' '123456:ABC...' > $tg_token_file && chmod 600 $tg_token_file" >&2
			return 1
		fi

		# Telegram's own token shape, the same one upstream's web UI validates against.
		# Catching a truncated paste here costs nothing; catching it at the API costs a
		# confused half hour reading a 401 that says nothing about the cause.
		if ! echo "$tg_token" | grep -qE '^[0-9]+:[A-Za-z0-9_-]{30,}$'; then
			echo "$NAME: the token in $tg_token_file is not shaped like a Telegram token" >&2
			echo "$NAME: (digits, a colon, then at least 30 more characters)." >&2
			return 1
		fi

		tg_allow=""
		config_list_foreach telegram allow_user_id append_allow_user

		# Upstream default-denies an unlisted user, so an empty allowlist is SAFE and
		# useless: the bot answers nobody and says nothing about why. Refusing here
		# turns a silent misconfiguration into one line in logread. allow_all exists
		# because it is upstream's own escape hatch, and it is spelled out rather than
		# implied so nobody reaches it by leaving a list empty.
		if [ -z "$tg_allow" ] && [ "$tg_allow_all" -ne 1 ]; then
			echo "$NAME: telegram is enabled but no user is allowed to talk to it." >&2
			echo "$NAME: add your numeric Telegram id (ask @userinfobot for it):" >&2
			echo "$NAME:   uci add_list hermes.telegram.allow_user_id=123456789" >&2
			echo "$NAME:   uci commit hermes && service hermes-agent restart" >&2
			echo "$NAME: or set hermes.telegram.allow_all=1 to answer anyone, which on a" >&2
			echo "$NAME: bot holding router tools means anyone who finds the bot." >&2
			return 1
		fi
	fi

	# The data directory is deliberately not created on the overlay by default. If it
	# is missing we make it, but a router whose overlay is a few megabytes should have
	# data_dir pointed at external storage instead, and this is where that gets said.
	if [ ! -d "$data_dir" ]; then
		mkdir -p "$data_dir" 2>/dev/null || {
			echo "$NAME: cannot create $data_dir" >&2; return 1; }
		echo "$NAME: created $data_dir on the root filesystem. Sessions and memory grow" >&2
		echo "$NAME: without bound; move data_dir to external storage if space is tight." >&2
	fi
	chmod 0700 "$data_dir" 2>/dev/null

	# @codex 2026-09-19: validate and persist the actual gateway contract before
	# opening any procd instance. A bad selection must never fall back to defaults.
	if [ -n "$mcp_url" ] && [ -z "$(read_secret "$mcp_token_file")" ]; then
		echo "$NAME: MCP token unavailable; starting without the UCI MCP connection" >&2
		mcp_url=""
	fi
	toolsets=""
	config_list_foreach main toolsets append_toolset
	HERMES_HOME="$data_dir" PYTHONPATH=/usr/lib/hermes-agent/site-packages \
		HERMES_OPENWRT_MAX_TURNS="$max_turns" \
		PYTHONDONTWRITEBYTECODE=1 /usr/bin/python3 /usr/libexec/hermes-set-toolsets \
		"$data_dir" "${toolsets#,}" "$mcp_url" "$base_url" "$model" "$profile" || return 1

	procd_open_instance
	# --external-supervisor, because procd IS one. Without it an in-chat restart or
	# update spawns a detached replacement that escapes procd, and the router ends up
	# with a gateway procd neither supervises nor can stop.
	# The key is read by a wrapper at exec time rather than handed to procd, so it
	# appears in neither argv nor procd's service table. See below.
	procd_set_param command /usr/sbin/hermes-gateway "$key_file"

	# Everything here is non-secret, so procd may hold it. The key is deliberately
	# absent: procd hands its whole env block back through
	#   ubus call service list '{"name":"hermes-agent"}'
	# which rpcd ACLs can expose to a LuCI session, so a secret placed here is readable
	# well beyond root. Found on hardware on 2026-09-13, after argv and uci had been
	# clean for months. -> check_key_not_in_procd_env
	procd_set_param env \
		HERMES_HOME="$data_dir" \
		HERMES_DISABLE_LAZY_INSTALLS=1 \
		PYTHONDONTWRITEBYTECODE=1 \
		OPENAI_BASE_URL="$base_url" \
		HERMES_MODEL="$model" \
		HERMES_MEM_MAX_MB="$mem_max" \
		HERMES_OPENWRT_TOOLSETS="${toolsets#,}" \
		HERMES_OPENWRT_MCP_URL="$mcp_url" \
		HERMES_OPENWRT_PROFILE="$profile" \
		HERMES_OPENWRT_MAX_TURNS="$max_turns"

	# HERMES_DISABLE_LAZY_INSTALLS is not optional here. Left unset, Hermes pip-installs
	# missing pieces at runtime, and a router has no compiler, often no free space, and
	# sometimes no route to PyPI. Upstream's own container image sets it for the same
	# reason.
	#
	# PYTHONDONTWRITEBYTECODE=1 because the package already ships every .pyc, compiled at
	# build time, so the router never needs to parse and never needs to write. Leaving
	# writing on is not merely redundant, it is harmful: any module that arrived without
	# its bytecode gets one written into the package's own directory, apk does not own
	# that file, and `apk del` then leaves the whole tree behind. A teeth run found
	# exactly that on 2026-09-08, from a package deliberately built with one .pyc
	# missing.

	[ -n "$mcp_url" ] && procd_append_param env HERMES_MCP_TOKEN_FILE="$mcp_token_file"

	# ---- Telegram: the export half ----
	# Validated above, before any procd state was touched. Only the handover is left,
	# and it has to be here because procd_append_param needs an open instance.
	if [ "$tg_on" -eq 1 ]; then
		procd_append_param env HERMES_TELEGRAM_TOKEN_FILE="$tg_token_file"
		[ -n "$tg_allow" ] && procd_append_param env TELEGRAM_ALLOWED_USERS="${tg_allow#,}"
		[ "$tg_allow_all" -eq 1 ] && procd_append_param env TELEGRAM_ALLOW_ALL_USERS=true
		[ -n "$tg_home" ] && procd_append_param env TELEGRAM_HOME_CHANNEL="$tg_home"
	fi

	[ "$respawn" -eq 1 ] && procd_set_param respawn 3600 5 5
	procd_set_param limits core="0"
	# The router's own work keeps the processor. Measured 2026-09-24 on a Brume 2
	# carrying a WireGuard tunnel: a conversation at the default priority took a third
	# of the tunnel's throughput while it ran, at nice 10 a quarter. Inherited by the
	# gateway the wrapper execs and by every tool process it starts.
	procd_set_param nice 10

	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile /var/run/$NAME.pid
	procd_close_instance
}

append_toolset() {
	toolsets="$toolsets,$1"
}

append_allow_user() {
	# Numeric ids only. A username here would be accepted by nothing downstream and
	# would look, in uci show, exactly like a working allowlist.
	case "$1" in
		''|*[!0-9]*) echo "$NAME: ignoring allow_user_id '$1': not a numeric Telegram id" >&2 ;;
		*) tg_allow="$tg_allow,$1" ;;
	esac
}

service_triggers() {
	procd_add_reload_trigger "hermes"
}

reload_service() {
	# Every setting this script reads is turned into an environment variable or an
	# argument at start time, so there is nothing a running process would pick up.
	restart
}

stop_service() {
	return 0
}
