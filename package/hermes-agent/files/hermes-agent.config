## Hermes Agent on OpenWrt.
##
## This file is a conffile: an upgrade never overwrites it, so anything you set here
## survives. Secrets do NOT belong in it. UCI files are world-readable by default and
## end up in support bundles and screenshots; put API keys in the file named by
## `key_file` below, which the package creates as root-only.

config hermes 'main'
	option enabled '0'
	# Off until you have pointed it at a model and a messaging platform. Turn on with:
	#   uci set hermes.main.enabled=1 && uci commit hermes && service hermes-agent restart

	## Which tools the agent may use, chosen here rather than left to the toolsets
	## list below. assistant (the default, and what applies if this is unset, on
	## every router including ones upgraded from before this option existed) keeps
	## terminal, code execution and file editing off no matter what toolsets says.
	## admin allows every tool the list below selects, running as root as today.
	##   uci set hermes.main.profile=admin && uci commit hermes && service hermes-agent restart
	option profile 'assistant'

	## Where sessions, memory, skills and logs live. This grows: sessions and memory are
	## a SQLite database that only gets bigger. Point it at external storage on any
	## router whose overlay is small, which is most of them.
	option data_dir '/srv/hermes'

	## The model. Hermes talks to anything that speaks the OpenAI protocol, so this is
	## the single knob that chooses between a cloud provider, your own gateway, or a
	## machine on the LAN running llama-server or Ollama.
	##
	##   https://openrouter.ai/api/v1        a cloud router, cheapest way to start
	##   http://10.0.0.5:8080/v1             your own box on the LAN, nothing leaves home
	##
	## A local model on the ROUTER itself is not a supported configuration and will not
	## work: the agent's own prompt is thousands of tokens, and a router CPU takes
	## minutes to read it before answering a word.
	option base_url 'https://openrouter.ai/api/v1'
	option model 'anthropic/claude-haiku-4.5'

	## The API key is read from this file, not from UCI. One line, the key alone.
	## The package creates it 0600 root:root and never writes a key into it.
	option key_file '/etc/hermes-agent/provider.key'

	## @codex 2026-09-19: gateway defaults for Telegram and cron. Empty selects none.
	## Per-job overrides, plugins and MCP retain upstream semantics; not a sandbox.
	## The service runs as root, including the file and terminal tools below.
	list toolsets 'file'
	list toolsets 'terminal'
	list toolsets 'web'
	list toolsets 'memory'
	list toolsets 'skills'
	list toolsets 'cronjob'
	list toolsets 'clarify'

	## @codex 2026-09-19: verified cgroup v2 ceiling for the gateway and descendants.
	## Requires writable memory control; unavailable means startup is refused.
	## 0 explicitly disables the limit. Root tools can change system controls.
	option mem_max_mb '512'

	## Restart if it dies. procd handles the backoff.
	option respawn '1'

	## @codex 2026-09-19: optional openwrt-mcp connection, with policy for MCP calls.
	## Empty disables this connection; it does not restrict local root tools.
	option router_mcp_url 'http://127.0.0.1:8730/mcp'
	option router_mcp_token_file '/etc/hermes-agent/router-mcp.token'

## One section per messaging platform. Only enabled ones are loaded, which is what
## keeps the resident footprint down: the gateway imports a platform's client library
## only when that platform is on.
config platform 'telegram'
	## Needs the hermes-agent-telegram package. The Telegram adapter itself already
	## ships in hermes-agent; the client library it loads does not, because a router
	## that will never use Telegram should not carry it. The service refuses to start
	## with this on and the package absent, and says so by name.
	option enabled '0'

	## The bot token from @BotFather, read from this file rather than from UCI. This
	## file is created 0600 root:root and the package never writes a token into it.
	##   printf '%s' '123456:ABC...' > /etc/hermes-agent/telegram.token
	option token_file '/etc/hermes-agent/telegram.token'

	## Who may talk to the agent, by numeric Telegram id. Ask @userinfobot for yours.
	##
	## An empty list means nobody. Upstream default-denies an unlisted user, so that is
	## safe, but it is also silent: the bot would answer nothing and explain nothing. So
	## the service refuses to start on an empty list instead, and this is the one thing
	## to fill in.
	# list allow_user_id '123456789'

	## Answer anyone who finds the bot. Spelled out rather than implied by an empty
	## list, because on an agent holding router tools this is the whole security model
	## being turned off, and nobody should arrive here by omission.
	option allow_all '0'

	## Chat id that scheduled jobs and notifications are delivered to. Optional; without
	## it the agent only ever replies where it was spoken to.
	# option home_channel '123456789'
