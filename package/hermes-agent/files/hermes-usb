#!/bin/sh
# hermes-usb -- keep Hermes's data directory on a USB stick, or bring it back inside.
#
#   hermes-usb status                       where the data directory lives, and its size
#   hermes-usb move <partition> [--format]  copy the data to the stick, mount the stick there
#   hermes-usb back                         copy the data back to the router's own storage
#
# The data directory is what Hermes writes to again and again: sessions, memory, logs, its
# state database. The programs are written once, at install. So this moves the data, and the
# router never depends on the stick: without it, Hermes does not start (the init says why)
# and everything else runs as before. A router whose writable layer lives on the stick
# (extroot) is a different, larger change, described in the README.
#
# What it guards against, each found on 2026-10-04 on a Flint 2 or in review:
#   - the service's stop returns before the gateway has exited, and the gateway removes its
#     pid file early in its shutdown and closes its database after. So it waits for the
#     gateway's process (the pid file is a JSON record, {"pid": N, ...}) and for the service's
#     memory group to hold no process (a cgroup file always reports size 0: read it).
#   - a freshly made ext4 keeps writing for hours on its own (lazy inode-table init), which
#     looks like a service wearing the stick. --format writes the tables at once instead.
#   - anything it cannot prove safe it refuses before writing: a device that is not on USB,
#     a disk with anything mounted, a data directory that is a mount point already or a
#     symbolic link, a stick too small (checked before --format erases it).
set -u
trap '' HUP
NAME=hermes-usb
SERVICE=${HERMES_USB_SERVICE:-/etc/init.d/hermes-agent}
CGROUP=${HERMES_USB_CGROUP:-/sys/fs/cgroup/services/hermes-agent/instance1}
MARGIN_KB=${HERMES_USB_MARGIN_KB:-65536}
TOOLS='kmod-usb-storage block-mount kmod-fs-ext4 e2fsprogs'

say()  { echo "$NAME: $*"; }
die()  { echo "$NAME: $*" >&2; exit 1; }
num()  { case "$1" in ''|*[!0-9]*) return 1 ;; esac; return 0; }

data_dir=$(uci -q get hermes.main.data_dir)
[ -n "$data_dir" ] || data_dir=/srv/hermes
while case "$data_dir" in */) true ;; *) false ;; esac; do data_dir=${data_dir%/}; done
case "$data_dir" in
	*/../*|*/..|*/./*|*/.|*//*) die "data_dir '$data_dir' has . or .. or // in it; give it as a plain absolute path" ;;
	/etc|/etc/*|/usr|/usr/*|/lib|/lib/*|/bin|/bin/*|/sbin|/sbin/*|/rom|/rom/*|/overlay|/overlay/*|/proc|/proc/*|/sys|/sys/*|/dev|/dev/*|/tmp|/tmp/*|/var|/var/*|/root|/root/*)
		die "data_dir '$data_dir' is inside a system tree; this command moves only a data directory such as /srv/hermes" ;;
	/?*/?*) ;;
	*) die "data_dir '$data_dir' is not a directory this command will move; set hermes.main.data_dir to a path such as /srv/hermes" ;;
esac

mounted_dev() { awk -v d="$1" '$2 == d { print $1 }' /proc/mounts | tail -n 1; }
uuid_of()     { block info "$1" 2>/dev/null | sed -n 's/.*UUID="\([^"]*\)".*/\1/p'; }
type_of()     { block info "$1" 2>/dev/null | sed -n 's/.*TYPE="\([^"]*\)".*/\1/p'; }
size_kb()     { du -sk "$1" 2>/dev/null | cut -f1; }
free_kb()     { df -Pk "$1" 2>/dev/null | awk 'NR == 2 { print $4 }'; }
files_in()    { find "$1" -xdev -type f ! -name gateway.pid ! -name gateway.sock | wc -l; }
tree_sums()   { ( cd "$1" && find . -xdev -type f ! -name gateway.pid ! -name gateway.sock -exec md5sum {} + | sort -k 2 ); }

# The copy is proven, or nothing switches: same checksums, the same number of files, and a
# list that is not empty when the source has files (an md5sum that failed lists nothing).
same_tree() {
	tree_sums "$1" > /tmp/hermes-usb.a 2>/dev/null; tree_sums "$2" > /tmp/hermes-usb.b 2>/dev/null
	n=$(files_in "$1")
	[ "$(wc -l < /tmp/hermes-usb.a)" -eq "$n" ] && [ "$(wc -l < /tmp/hermes-usb.b)" -eq "$n" ] \
		&& cmp -s /tmp/hermes-usb.a /tmp/hermes-usb.b
	r=$?; rm -f /tmp/hermes-usb.a /tmp/hermes-usb.b; return $r
}

need_tools() {
	missing=""
	for p in $TOOLS; do apk info -e "$p" >/dev/null 2>&1 || missing="$missing $p"; done
	[ -z "$missing" ] && return 0
	echo "$NAME: these packages are needed first:$missing" >&2
	echo "$NAME:   apk update && apk add$missing" >&2
	echo "$NAME: nothing was changed." >&2
	exit 2
}

# A partition on a USB disk, and nothing on that disk in use. HERMES_USB_ANY_DEVICE=1 lifts the
# USB test for the gate, whose stick is a loop device; nothing else lifts it.
check_device() {
	part=$1; name=${part#/dev/}
	[ -b "$part" ] || die "$part is not a block device; block info lists the partitions the router sees"
	[ -e "/sys/class/block/$name" ] || die "$part is not known to the kernel as a block device"
	if [ "${HERMES_USB_ANY_DEVICE:-}" != 1 ]; then
		case "$(readlink -f "/sys/class/block/$name")" in
			*/usb[0-9]*/*) ;;
			*) die "$part is not on USB; this command only uses a USB stick, never the router's own storage" ;;
		esac
	fi
	disk=$name
	[ -e "/sys/class/block/$name/partition" ] && disk=$(basename "$(dirname "$(readlink -f "/sys/class/block/$name")")")
	for d in "$disk" $(ls "/sys/class/block/$disk" 2>/dev/null | grep "^$disk"); do
		[ -n "$(ls "/sys/class/block/$d/holders" 2>/dev/null)" ] && die "/dev/$d is held by another device (a loop, an md or a mapper); nothing was changed"
		where=$(awk -v p="/dev/$d" '$1 == p { print $2 }' /proc/mounts | head -n 1)
		[ -z "$where" ] || die "/dev/$d is mounted on $where; the disk is in use, so it was left alone. Unmount it first if it is the stick you mean."
	done
	return 0
}

gw=""
gateway_pid() { sed -n 's/.*"pid"[^0-9]*\([0-9][0-9]*\).*/\1/p; s/^\([0-9][0-9]*\)$/\1/p' "$1/gateway.pid" 2>/dev/null | head -n 1; }
busy() {  # the gateway's own process, or anything in the service's group
	[ -n "$gw" ] && [ -d "/proc/$gw" ] && return 0
	[ -n "$(cat "$CGROUP/cgroup.procs" 2>/dev/null)" ] && return 0
	return 1
}
was_running=0
stop_gateway() {
	gw=$(gateway_pid "$1")
	{ [ -n "$gw" ] && [ -d "/proc/$gw" ]; } || [ -n "$(cat "$CGROUP/cgroup.procs" 2>/dev/null)" ] && was_running=1
	"$SERVICE" stop >/dev/null 2>&1
	i=0
	while busy && [ "$i" -lt 60 ]; do sleep 1; i=$((i + 1)); done
	busy && { restart; die "the gateway did not stop within 60 s; nothing was moved"; }
	return 0
}
restart() { [ "$was_running" = 1 ] && "$SERVICE" start >/dev/null 2>&1; return 0; }

status() {
	dev=$(mounted_dev "$data_dir")
	want=$(uci -q get hermes.main.data_uuid)
	if [ -n "$dev" ] && [ -n "$want" ] && [ "$(uuid_of "$dev")" != "$want" ]; then
		say "$data_dir has $dev mounted on it (UUID $(uuid_of "$dev")), but Hermes's data belongs on the stick with UUID $want; Hermes will not start"
	elif [ -n "$dev" ]; then
		say "$data_dir is on $dev (UUID $(uuid_of "$dev")), $(size_kb "$data_dir") KiB used, $(free_kb "$data_dir") KiB free"
	elif [ -n "$want" ]; then
		say "$data_dir should be on the stick with UUID $want, and that stick is not mounted; Hermes will not start until it is"
	elif [ -d "$data_dir" ]; then
		say "$data_dir is on the router's own storage, $(size_kb "$data_dir") KiB used"
	else
		say "$data_dir does not exist yet; it is made at the agent's first start, on the router's own storage"
	fi
}

move() {
	part=${1:-}; fmt=${2:-}
	[ -n "$part" ] || die "usage: hermes-usb move <partition> [--format], for example /dev/sda1 (block info lists them)"
	[ -z "$fmt" ] || [ "$fmt" = --format ] || die "unknown option '$fmt'"
	need_tools
	[ -z "$(uci -q get hermes.main.data_uuid)" ] || die "the data is on a stick already (hermes-usb status); run hermes-usb back first"
	[ -L "$data_dir" ] && die "$data_dir is a symbolic link; point hermes.main.data_dir at the real directory first"
	[ -d "$data_dir" ] || die "$data_dir does not exist yet; start Hermes once, then move it"
	m=$(mounted_dev "$data_dir")
	[ -z "$m" ] || die "$data_dir already has $m mounted on it (set up by hand?); unmount it and remove its fstab section, then run this again"
	s=$(uci -q show fstab | grep -F -e ".target='$data_dir'" | head -n 1 | sed 's/^fstab\.\([^.]*\)\..*/\1/')
	[ -z "$s" ] || die "/etc/config/fstab section '$s' already mounts something on $data_dir; remove it first"
	check_device "$part"

	need=$(( $(size_kb "$data_dir") + MARGIN_KB ))
	t=$(type_of "$part")
	if [ "$fmt" = --format ]; then
		sectors=$(cat "/sys/class/block/${part#/dev/}/size" 2>/dev/null)
		num "$sectors" || die "cannot read the size of $part; nothing was changed"
		# what an empty ext4 leaves free is at least about 90 % of the partition
		[ $(( sectors / 2 * 9 / 10 )) -ge "$need" ] || die "$part holds $(( sectors / 2 )) KiB and needs room for $need ($data_dir plus $MARGIN_KB KiB); nothing was changed"
		say "formatting $part as ext4 (everything on it is erased)"
		mkfs.ext4 -F -q -L hermes-data -E lazy_itable_init=0,lazy_journal_init=0 "$part" || die "mkfs.ext4 failed on $part"
	elif [ "$t" != ext4 ]; then
		die "$part holds ${t:-no filesystem}, not ext4; hermes-usb move $part --format would erase it and make ext4"
	fi
	uuid=$(uuid_of "$part"); [ -n "$uuid" ] || die "no UUID on $part"

	mnt=/tmp/hermes-usb.$$
	mkdir -p "$mnt" && mount -t ext4 -o rw,noatime "$part" "$mnt" || die "could not mount $part"
	have=$(free_kb "$mnt")
	if ! num "$have" || [ "$have" -lt "$need" ]; then
		umount "$mnt"; rmdir "$mnt"
		die "$part has ${have:-an unknown amount of} KiB free and needs $need ($data_dir plus $MARGIN_KB KiB of room); nothing was changed"
	fi
	if [ -n "$(ls -A "$mnt" | grep -v '^lost+found$')" ]; then
		umount "$mnt"; rmdir "$mnt"
		die "$part is not empty; use an empty partition, or --format to erase it"
	fi

	stop_gateway "$data_dir"
	if ! cp -a "$data_dir/." "$mnt/" || ! same_tree "$data_dir" "$mnt"; then
		umount "$mnt"; rmdir "$mnt"; restart
		die "the copy on $part does not match $data_dir; nothing was switched, the data is still in $data_dir"
	fi
	n=$(files_in "$data_dir")
	umount "$mnt"; rmdir "$mnt"

	[ -f /etc/config/fstab ] || printf "config global\n\toption anon_mount '0'\n\toption auto_mount '1'\n\toption delay_root '5'\n\toption check_fs '0'\n" > /etc/config/fstab
	uci -q delete fstab.hermes_data
	uci set fstab.hermes_data=mount
	uci set fstab.hermes_data.uuid="$uuid"
	uci set fstab.hermes_data.target="$data_dir"
	uci set fstab.hermes_data.fstype=ext4
	uci set fstab.hermes_data.options=rw,noatime
	uci set fstab.hermes_data.enabled=1
	uci commit fstab
	uci set hermes.main.data_uuid="$uuid"; uci commit hermes

	# The copy is proven; the one inside goes, so nothing writes there again by mistake.
	[ -z "$(mounted_dev "$data_dir")" ] || die "$data_dir became a mount point meanwhile; nothing inside was removed"
	find "$data_dir" -xdev -mindepth 1 -maxdepth 1 -exec rm -rf {} +
	block mount >/dev/null 2>&1
	[ "$(uuid_of "$(mounted_dev "$data_dir")")" = "$uuid" ] || mount -t ext4 -o rw,noatime "$part" "$data_dir" \
		|| die "could not mount $part on $data_dir; the data is safe on the stick, run hermes-usb back after checking it"
	[ "$(uuid_of "$(mounted_dev "$data_dir")")" = "$uuid" ] || die "$data_dir is not on $part after mounting"
	restart
	say "moved $n files to $part (UUID $uuid), mounted on $data_dir by its UUID from /etc/config/fstab; Hermes $( [ "$was_running" = 1 ] && echo restarted || echo 'left stopped, as it was')"
}

back() {
	want=$(uci -q get hermes.main.data_uuid)
	[ -n "$want" ] || die "the data is on the router's own storage already"
	dev=$(mounted_dev "$data_dir")
	[ -n "$dev" ] || die "the stick with UUID $want is not mounted on $data_dir; plug it in first"
	[ "$(uuid_of "$dev")" = "$want" ] || die "$data_dir has $dev mounted, not the stick with UUID $want; nothing was changed"
	parent=$(dirname "$data_dir"); tmp="$parent/.hermes-usb-back.$$"
	need=$(( $(size_kb "$data_dir") + MARGIN_KB )); have=$(free_kb "$parent")
	num "$have" && [ "$have" -ge "$need" ] || die "the router's own storage has ${have:-an unknown amount of} KiB free under $parent and needs $need"
	stop_gateway "$data_dir"
	if ! { mkdir -p "$tmp" && cp -a "$data_dir/." "$tmp/" && same_tree "$data_dir" "$tmp"; }; then
		rm -rf "$tmp"; restart; die "the copy does not match the stick; nothing was switched"
	fi
	n=$(files_in "$tmp")
	umount "$data_dir" || { rm -rf "$tmp"; restart; die "could not unmount $data_dir"; }
	[ -z "$(mounted_dev "$data_dir")" ] || { rm -rf "$tmp"; die "$data_dir is still a mount point after unmounting; nothing was switched, the copy was removed"; }
	rmdir "$data_dir" || die "$data_dir is not empty underneath the stick; nothing was switched, the copy is in $tmp"
	mv "$tmp" "$data_dir" && chmod 0700 "$data_dir" || die "could not put the copy in place; it is in $tmp"
	# only now does the router stop expecting the stick
	uci -q delete fstab.hermes_data; uci commit fstab
	uci -q delete hermes.main.data_uuid; uci commit hermes
	restart
	say "brought $n files back to $data_dir on the router's own storage; the stick ($dev) is no longer used and can be removed"
}

case "${1:-}" in
	status) status ;;
	move)   shift; move "$@" ;;
	back)   back ;;
	*) echo "usage: hermes-usb status | move <partition> [--format] | back" >&2; exit 2 ;;
esac
