#!/bin/sh
# hermes-usb -- keep Hermes's data directory on a USB stick, or bring it back inside.
#
#   hermes-usb status                       where the data directory lives, and its size
#   hermes-usb move <partition> [--format]  copy the data to the stick, mount the stick there
#   hermes-usb back                         copy the data back to the router's own storage
#   hermes-usb forget --yes                 give up a stick that is lost: the data on it stays
#                                           there, and Hermes starts again with an empty data
#                                           directory inside
#
# The data directory is what Hermes writes to again and again: sessions, memory, logs, its
# state database. The programs are written once, at install. So this moves the data, and the
# router never depends on the stick: without it Hermes does not start (the init, the gateway
# wrapper, the hermes launcher and hermes-login all ask /usr/lib/hermes-agent/hermes-usb-check),
# the block hotplug script starts it when the stick is mounted and stops it when the stick goes,
# and everything else on the router runs as before. A router whose writable layer lives on the
# stick (extroot) is a different, larger change, described in the README.
#
# The one record that the data is on a stick is the fstab section hermes_data: written in one
# commit when the data is on the stick and mounted, removed in one commit when it is back.
#
# What it guards against, each found on 2026-10-04 on a Flint 2, a Brume 2 or in review:
#   - the service's stop returns before the gateway has exited, and the gateway removes its
#     pid file early in its shutdown and closes its database after. So it waits for the
#     gateway's process (the pid file is a JSON record, {"pid": N, ...}) and for the service's
#     memory group to hold no process (a cgroup file always reports size 0: read it).
#   - a freshly made ext4 keeps writing for hours on its own (lazy inode-table init), which
#     looks like a service wearing the stick. --format writes the tables at once instead.
#   - anything it cannot prove safe it refuses before writing.
#   - nothing is ever moved into a directory that exists, and nothing inside is deleted until
#     the stick is mounted where it belongs and checked. A copy set aside keeps a fixed name, so
#     a power cut in the middle leaves it where hermes-usb-check finds it and names it, and no
#     later run can mistake it for its own.
#   - while it runs, its lock (holding its pid) keeps the init, the wrapper, the hotplug
#     script, hermes-login and a root shell's hermes from starting on a directory that is half
#     moved, and a process already using the directory stops it before anything is copied.
#   - `uci commit` on a full filesystem returned 0 and left /etc/config/fstab empty (OpenWrt
#     25.12.4), and uci's own reads include changes still waiting in /tmp/.uci. So the room is
#     checked first, someone else's waiting changes are refused rather than committed with the
#     record, and every commit is read back from the file itself; one that did not land is
#     undone, the file restored from a copy in RAM, and nothing is switched.
set -u
cd /
trap '' HUP PIPE
NAME=hermes-usb
SERVICE=${HERMES_USB_SERVICE:-/etc/init.d/hermes-agent}
CGROUP=${HERMES_USB_CGROUP:-/sys/fs/cgroup/services/hermes-agent/instance1}
MARGIN_KB=${HERMES_USB_MARGIN_KB:-65536}
TOOLS='kmod-usb-storage block-mount kmod-fs-ext4 e2fsprogs'
. /usr/lib/hermes-agent/hermes-usb-check
export HERMES_USB_SELF=1

say()  { echo "$NAME: $*"; }
die()  { echo "$NAME: $*" >&2; exit 1; }
num()  { case "$1" in ''|*[!0-9]*) return 1 ;; esac; return 0; }

[ "$(id -u)" = 0 ] || die "run this as root"

mnt=""; locked=0; stopped=0; was_running=0
restart() { stopped=0; [ "$was_running" = 1 ] && "$SERVICE" start >/dev/null 2>&1; return 0; }
unlock()  { [ "$locked" = 1 ] && rm -rf "$HERMES_USB_LOCK"; locked=0; return 0; }
cleanup() {
	[ -n "$mnt" ] && { umount "$mnt" 2>/dev/null; rmdir "$mnt" 2>/dev/null; }
	unlock
	[ "$stopped" = 1 ] && restart
	rm -rf "/tmp/hermes-usb.$$.a" "/tmp/hermes-usb.$$.b" "/tmp/hermes-usb.$$.uci"
	[ -n "${keep_saved:-}" ] || rm -f "/tmp/hermes-usb.$$.fstab"
}
trap cleanup EXIT
trap 'exit 1' INT TERM
lock() {
	if ! mkdir "$HERMES_USB_LOCK" 2>/dev/null; then
		p=$(cat "$HERMES_USB_LOCK/pid" 2>/dev/null)
		[ -n "$p" ] && grep -q hermes-usb "/proc/$p/cmdline" 2>/dev/null && die "another hermes-usb (pid $p) is running"
		rm -rf "$HERMES_USB_LOCK"; mkdir "$HERMES_USB_LOCK" 2>/dev/null || die "cannot take $HERMES_USB_LOCK"
	fi
	echo $$ > "$HERMES_USB_LOCK/pid"; locked=1
}

mounted_on()  { df -P "$1" 2>/dev/null | awk 'NR == 2 { print $6 }'; }
uuid_of()     { block info "$1" 2>/dev/null | sed -n 's/.*UUID="\([^"]*\)".*/\1/p'; }
type_of()     { block info "$1" 2>/dev/null | sed -n 's/.*TYPE="\([^"]*\)".*/\1/p'; }
size_kb()     { du -sk "$1" 2>/dev/null | cut -f1; }
free_kb()     { df -Pk "$1" 2>/dev/null | awk 'NR == 2 { print $4 }'; }
# a process other than this one with its working directory or an open file in $1: "pid command"
dir_user() {
	ls -l /proc/[0-9]*/cwd /proc/[0-9]*/root /proc/[0-9]*/fd 2>/dev/null | awk -v d="$1" -v me="$$" '
		/^\/proc\/[0-9]+\/fd:$/ { split($0, a, "/"); pid = a[3]; next }
		/ -> / {
			i = index($0, " -> "); t = substr($0, i + 4)   # a deleted file: "<path> (deleted)"
			n = split(substr($0, 1, i - 1), w, " "); who = pid
			if (w[n] ~ /^\/proc\/[0-9]+\/(cwd|root)$/) { split(w[n], a, "/"); who = a[3] }
			if (who != me && (t == d || index(t, d "/") == 1)) { print who; exit }
		}' | while read -r u; do echo "$u ($(tr '\0' ' ' < "/proc/$u/cmdline" 2>/dev/null | cut -c 1-60))"; done
}
nobody_else_in() {
	u=$(dir_user "$1")
	[ -z "$u" ] || die "process $u has files open in $1; stop it first (a shell working there only needs to cd out of it). Nothing was moved"
}

# The file as uci itself reads it: a copy under another package name with its own save
# directory, so changes waiting in /tmp/.uci for fstab play no part. uci still applies what
# /tmp/.uci holds under the copy's own name, so fstab_writable refuses while a change waits there. A file uci cannot parse
# (a commit cut off inside a value keeps its uuid and target lines) has no record for
# flash_record and makes fstab_others fail, as block-mount would fail to read it at boot.
UCI_COPY=/tmp/hermes-usb.$$.uci; COPY=hermes_usb_copy
ucopy() { uci -q -c "$UCI_COPY/c" -t "$UCI_COPY/s" "$@"; }
read_fstab() {
	rm -rf "$UCI_COPY"; mkdir -p "$UCI_COPY/c" "$UCI_COPY/s" && cp "$1" "$UCI_COPY/c/$COPY" 2>/dev/null
}
# the record as /etc/config/fstab on flash has it: "uuid target", nothing when there is none
flash_record() {
	read_fstab /etc/config/fstab || return 1
	ucopy get hermes_usb_copy.hermes_data >/dev/null || return 0
	echo "$(ucopy get hermes_usb_copy.hermes_data.uuid) $(ucopy get hermes_usb_copy.hermes_data.target)"
}
# every other section of file $1, as uci reads it: what a commit of the record must leave as it was
fstab_others() {
	read_fstab "$1" || return 1
	ucopy delete hermes_usb_copy.hermes_data
	ucopy show hermes_usb_copy
}
CONF_ROOM_KB=256
fstab_writable() {
	[ ! -e "/tmp/.uci/$COPY" ] || die "/tmp/.uci/$COPY holds uci changes for the name this command reads /etc/config/fstab under, which would change what it reads; remove that file first. Nothing was changed"
	[ -z "$(uci -q changes fstab)" ] || die "/etc/config/fstab has changes waiting to be committed (uci changes fstab); commit or revert them first, so this command commits only its own. Nothing was changed"
	have=$(free_kb /etc/config)
	num "$have" && [ "$have" -ge "$CONF_ROOM_KB" ] || die "the router's own storage has ${have:-an unknown amount of} KiB free where /etc/config lives; recording the stick needs $CONF_ROOM_KB, and a full one can leave /etc/config/fstab empty. Nothing was changed"
}
# One commit of fstab, read back from the file: $1 what flash_record must then say ("" for no
# section), with every other section as it was. A commit that did not land (a file left empty
# reads as "no section", so the other sections are what tell) is undone: the waiting change
# dropped, the file as it was. Without a copy to put back, nothing is committed.
commit_fstab() {
	saved=/tmp/hermes-usb.$$.fstab
	cp /etc/config/fstab "$saved" 2>/dev/null && cmp -s /etc/config/fstab "$saved" \
		|| { uci -q revert fstab; echo "$NAME: could not keep a copy of /etc/config/fstab in /tmp to put back should the commit not land (is /tmp full?), so nothing was committed" >&2; return 1; }
	uci commit fstab; rc=$?; sync
	if [ "$rc" = 0 ] && rec=$(flash_record) && [ "$rec" = "$1" ] \
		&& now=$(fstab_others /etc/config/fstab) && was=$(fstab_others "$saved") && [ "$now" = "$was" ]; then
		return 0
	fi
	uci -q revert fstab
	if ! cmp -s "$saved" /etc/config/fstab; then
		# put back by a rename, so a failure half way leaves the file no worse than the commit did
		{ cp "$saved" /etc/config/.fstab.hermes-usb && sync && mv /etc/config/.fstab.hermes-usb /etc/config/fstab \
			&& sync && cmp -s "$saved" /etc/config/fstab; } || {
			rm -f /etc/config/.fstab.hermes-usb
			fstab_lost=/tmp/hermes-usb.fstab.saved.$$
			{ [ ! -e "$fstab_lost" ] && mv "$saved" "$fstab_lost" && [ -f "$fstab_lost" ]; } || { fstab_lost=$saved; keep_saved=1; }
			echo "$NAME: /etc/config/fstab could not be put back as it was; what it held before is in $fstab_lost, in RAM: copy it somewhere safe" >&2
		}
	fi
	return 1
}
fstab_lost=""; keep_saved=""

files_in()    { find "$1" -xdev -type f ! -name gateway.pid ! -name gateway.sock | wc -l; }
tree_sums()   { ( cd "$1" && find . -xdev -type f ! -name gateway.pid ! -name gateway.sock -exec md5sum {} + | sort -k 2 ); }

# The copy is proven, or nothing switches: same checksums, the same number of files, and a
# list as long as the tree (an md5sum that failed lists nothing).
same_tree() {
	a=/tmp/hermes-usb.$$.a; b=/tmp/hermes-usb.$$.b
	tree_sums "$1" > "$a" 2>/dev/null; tree_sums "$2" > "$b" 2>/dev/null
	n=$(files_in "$1")
	[ "$(wc -l < "$a")" -eq "$n" ] && [ "$(wc -l < "$b")" -eq "$n" ] && cmp -s "$a" "$b"
	r=$?; rm -f "$a" "$b"; return $r
}

need_tools() {
	missing=""
	for p in $TOOLS; do apk info -e "$p" >/dev/null 2>&1 || missing="$missing $p"; done
	[ -z "$missing" ] && return 0
	echo "$NAME: these packages are needed first:$missing" >&2
	echo "$NAME:   apk update && apk add$missing" >&2
	echo "$NAME: nothing was changed." >&2
	exit 2
}

# A partition on a USB disk, and nothing on that disk in use. The USB test is lifted only by
# the gate, whose stick is a loop device, through a file no package ships.
check_device() {
	part=$1; name=${part#/dev/}
	[ -b "$part" ] || die "$part is not a block device; block info lists the partitions the router sees"
	[ -e "/sys/class/block/$name" ] || die "$part is not known to the kernel as a block device"
	[ -e "/sys/class/block/$name/partition" ] || die "$part is a whole disk; name one of its partitions (block info lists them), so its partition table is left alone"
	if [ ! -e /etc/hermes-usb.gate-any-device ]; then
		case "$(readlink -f "/sys/class/block/$name")" in
			*/usb[0-9]*/*) ;;
			*) die "$part is not on USB; this command only uses a USB stick, never the router's own storage" ;;
		esac
	fi
	disk=$(basename "$(dirname "$(readlink -f "/sys/class/block/$name")")")
	for d in "$disk" $(ls "/sys/class/block/$disk" 2>/dev/null | grep "^$disk"); do
		[ -n "$(ls "/sys/class/block/$d/holders" 2>/dev/null)" ] && die "/dev/$d is held by another device (a loop, an md or a mapper); nothing was changed"
		where=$(awk -v p="/dev/$d" '$1 == p { print $2 }' /proc/mounts | head -n 1)
		[ -z "$where" ] || die "/dev/$d is mounted on $where; the disk is in use, so it was left alone. Unmount it first if it is the stick you mean."
		grep -q "^/dev/$d " /proc/swaps 2>/dev/null && die "/dev/$d is in use as swap; the disk was left alone"
	done
	return 0
}

gw=""
gateway_pid() { sed -n -e 's/.*"pid"[^0-9]*\([0-9][0-9]*\).*/\1/p' -e t -e 's/^\([0-9][0-9]*\)$/\1/p' "$1/gateway.pid" 2>/dev/null | head -n 1; }
gateway_alive() { [ -n "$gw" ] && [ -d "/proc/$gw" ] && grep -q hermes "/proc/$gw/cmdline" 2>/dev/null; }
group_busy()    { [ -n "$(cat "$CGROUP/cgroup.procs" 2>/dev/null)" ]; }
stop_gateway() {
	gw=$(gateway_pid "$1")
	{ gateway_alive || group_busy; } && was_running=1
	"$SERVICE" stop >/dev/null 2>&1; stopped=1
	i=0
	while { gateway_alive || group_busy; } && [ "$i" -lt 60 ]; do sleep 1; i=$((i + 1)); done
	{ gateway_alive || group_busy; } && die "the gateway did not stop within 60 s; nothing was moved"
	return 0
}

# Put a directory set aside back in place, never into a directory that exists.
put_back() {  # $1 the copy set aside, $2 where it belongs
	[ -e "$2" ] && { rmdir "$2" 2>/dev/null || die "could not clear $2 to put the data back; the data is safe in $1, which nothing will start on until it is back in $2"; }
	mv "$1" "$2" || die "could not put the data back; it is safe in $1"
}

data_dir_for_move() {
	data_dir=$(uci -q get hermes.main.data_dir)
	[ -n "$data_dir" ] || data_dir=/srv/hermes
	while case "$data_dir" in */) true ;; *) false ;; esac; do data_dir=${data_dir%/}; done
	case "$data_dir" in
		*" "*|*"	"*) die "data_dir '$data_dir' has a space in it; give it a plain path such as /srv/hermes" ;;
		*/../*|*/..|*/./*|*/.|*//*) die "data_dir '$data_dir' has . or .. or // in it; give it as a plain absolute path" ;;
		/etc|/etc/*|/usr|/usr/*|/lib|/lib/*|/bin|/bin/*|/sbin|/sbin/*|/rom|/rom/*|/overlay|/overlay/*|/proc|/proc/*|/sys|/sys/*|/dev|/dev/*|/tmp|/tmp/*|/var|/var/*|/root|/root/*|/mnt|/mnt/*)
			die "data_dir '$data_dir' is inside a system tree or under /mnt; this command moves only a data directory such as /srv/hermes" ;;
		/?*/?*) ;;
		*) die "data_dir '$data_dir' is not a directory this command will move; set hermes.main.data_dir to a path such as /srv/hermes" ;;
	esac
}

status() {
	uuid=$(hermes_data_stick)
	if [ -n "$uuid" ]; then
		target=$(uci -q get fstab.hermes_data.target)
		if why=$(hermes_data_ok "$target"); then
			say "$target is on $(hermes_mount_source "$target") (UUID $uuid), $(size_kb "$target") KiB used, $(free_kb "$target") KiB free"
		else
			say "the data belongs on the stick with UUID $uuid at $target; $why"
		fi
		return 0
	fi
	data_dir=$(uci -q get hermes.main.data_dir); [ -n "$data_dir" ] || data_dir=/srv/hermes
	if why=$(hermes_data_ok "$data_dir"); then :; else say "$why"; return 0; fi
	if [ -d "$data_dir" ]; then
		say "$data_dir is on the router's own storage, $(size_kb "$data_dir") KiB used"
	else
		say "$data_dir does not exist yet; it is made at the agent's first start, on the router's own storage"
	fi
}

move() {
	part=${1:-}; fmt=${2:-}
	[ -n "$part" ] || die "usage: hermes-usb move <partition> [--format], for example /dev/sda1 (block info lists them)"
	[ -z "$fmt" ] || [ "$fmt" = --format ] || die "unknown option '$fmt'"
	data_dir_for_move
	need_tools
	lock
	[ -z "$(hermes_data_stick)" ] || die "the data is on a stick already (hermes-usb status); run hermes-usb back first"
	left=$(hermes_data_leftovers "$data_dir"); [ -z "$left" ] || die "an interrupted hermes-usb left $left; sort that out first (hermes-usb status)"
	[ -d "$data_dir" ] || die "$data_dir does not exist yet; start Hermes once, then move it"
	[ "$(readlink -f "$data_dir")" = "$data_dir" ] || die "$data_dir is reached through a symbolic link (it is really $(readlink -f "$data_dir")); point hermes.main.data_dir at the real path first"
	[ "$(mounted_on "$data_dir")" = / ] && [ -z "$(hermes_mount_source "$data_dir")" ] \
		|| die "$data_dir is not on the router's own root filesystem (it is on $(df -P "$data_dir" | awk 'NR == 2 { print $1 " at " $6 }')); unmount it, remove what mounts it from the fstab, and run this again"
	s=$(uci -q show fstab | grep -F -e ".target='$data_dir'" | head -n 1 | sed 's/^fstab\.\([^.]*\)\..*/\1/')
	[ -z "$s" ] || die "/etc/config/fstab section '$s' already mounts something on $data_dir; remove it first"
	check_device "$part"
	fstab_writable

	need=$(( $(size_kb "$data_dir") + MARGIN_KB ))
	t=$(type_of "$part"); formatted=""
	if [ "$fmt" = --format ]; then
		sectors=$(cat "/sys/class/block/${part#/dev/}/size" 2>/dev/null)
		num "$sectors" || die "cannot read the size of $part; nothing was changed"
		# an empty ext4 made with -m 0 leaves well over 80 % of a partition free, small ones included
		[ $(( sectors / 2 * 8 / 10 )) -ge "$need" ] || die "$part holds $(( sectors / 2 )) KiB and needs room for $need ($data_dir plus $MARGIN_KB KiB); nothing was changed"
		say "formatting $part as ext4 (everything on it is erased)"
		mkfs.ext4 -F -q -m 0 -L hermes-data -E lazy_itable_init=0,lazy_journal_init=0 "$part" || die "mkfs.ext4 failed on $part"
		formatted=" ($part was formatted)"
	elif [ "$t" != ext4 ]; then
		die "$part holds ${t:-no filesystem}, not ext4; hermes-usb move $part --format would erase it and make ext4"
	fi
	uuid=$(uuid_of "$part"); [ -n "$uuid" ] || die "no UUID on $part"

	mnt=/tmp/hermes-usb.$$
	mkdir -p "$mnt" && mount -t ext4 -o rw,noatime "$part" "$mnt" || { rmdir "$mnt" 2>/dev/null; mnt=""; die "could not mount $part$formatted"; }
	have=$(free_kb "$mnt")
	num "$have" && [ "$have" -ge "$need" ] || die "$part has ${have:-an unknown amount of} KiB free and needs $need ($data_dir plus $MARGIN_KB KiB of room); nothing else was changed$formatted"
	[ -z "$(ls -A "$mnt" | grep -v '^lost+found$')" ] || die "$part is not empty; use an empty partition, or --format to erase it"

	stop_gateway "$data_dir"
	nobody_else_in "$data_dir"
	cp -a "$data_dir/." "$mnt/" && same_tree "$data_dir" "$mnt" \
		|| die "the copy on $part does not match $data_dir; nothing was switched, the data is still in $data_dir"
	n=$(files_in "$data_dir")
	fstab_writable   # again: the copy can take minutes, and someone may have started an fstab change
	umount "$mnt" || die "could not unmount $part from $mnt; nothing was switched, the data is still in $data_dir"
	rmdir "$mnt"; mnt=""

	# The inside copy is set aside under a fixed name, not deleted, until the stick is on
	# $data_dir and checked.
	owner=$(ls -ld "$data_dir" | awk '{ print $3 ":" $4 }')
	aside="$data_dir.hermes-usb-inside"
	mv "$data_dir" "$aside" || die "could not set $data_dir aside; nothing was switched"
	mkdir -m 0700 "$data_dir" || { put_back "$aside" "$data_dir"; die "could not make the mount point $data_dir; nothing was switched"; }
	if ! mount -t ext4 -o rw,noatime "$part" "$data_dir"; then
		put_back "$aside" "$data_dir"; die "could not mount $part on $data_dir; nothing was switched, the data is still in $data_dir"
	fi
	chown "$owner" "$data_dir" 2>/dev/null
	[ -f /etc/config/fstab ] || printf "config global\n\toption anon_mount '0'\n\toption auto_mount '1'\n\toption delay_root '5'\n\toption check_fs '0'\n" > /etc/config/fstab
	uci -q delete fstab.hermes_data
	uci set fstab.hermes_data=mount
	uci set fstab.hermes_data.uuid="$uuid"
	uci set fstab.hermes_data.target="$data_dir"
	uci set fstab.hermes_data.fstype=ext4
	uci set fstab.hermes_data.options=rw,noatime
	uci set fstab.hermes_data.enabled=1
	why=""
	if ! commit_fstab "$uuid $data_dir"; then
		why="the stick's record could not be committed to /etc/config/fstab (is the router's own storage, or /tmp, full or read-only?)"
		[ -z "$fstab_lost" ] || why="$why; put $fstab_lost back as /etc/config/fstab"
	elif ! why=$(hermes_stick_on "$data_dir" "$uuid"); then
		uci -q delete fstab.hermes_data
		if ! commit_fstab ""; then
			why="$why, and its record could not be removed from /etc/config/fstab again"
			if [ -n "$fstab_lost" ]; then why="$why; put $fstab_lost back as /etc/config/fstab, then remove section hermes_data from it (uci delete fstab.hermes_data; uci commit fstab)"
			else why="$why; remove it by hand (uci delete fstab.hermes_data; uci commit fstab)"; fi
		fi
	fi
	if [ -n "$why" ]; then
		umount "$data_dir" || die "after mounting, $why, and $data_dir would not unmount; the data is safe in $aside"
		put_back "$aside" "$data_dir"
		die "after mounting, $why; nothing was switched, the data is still in $data_dir"
	fi
	rm -rf "$aside"
	[ "$(uci -q get fstab.@global[0].auto_mount)" = 0 ] && say "note: auto_mount is 0 in /etc/config/fstab, so a stick plugged in later is not mounted by itself"
	unlock; restart
	say "moved $n files to $part (UUID $uuid), mounted on $data_dir by its UUID from /etc/config/fstab; Hermes $( [ "$was_running" = 1 ] && echo restarted || echo 'left stopped, as it was')"
}

# the stick of record on $1, mounted on top there: the one check move needs while its own
# set-aside copy still exists (hermes_data_ok would name that copy)
hermes_stick_on() {
	_d=$(hermes_mount_source "$1")
	[ -n "$_d" ] || { echo "nothing is mounted on $1"; return 1; }
	[ "$(uuid_of "$_d")" = "$2" ] || { echo "$1 has $_d mounted, not the stick with UUID $2"; return 1; }
	return 0
}

back() {
	lock
	uuid=$(hermes_data_stick)
	[ -n "$uuid" ] || die "the data is on the router's own storage already"
	target=$(uci -q get fstab.hermes_data.target)
	why=$(hermes_data_ok "$target") || die "$why"
	fstab_writable
	dev=$(hermes_mount_source "$target")
	parent=$(dirname "$target"); tmp="$parent/.hermes-usb-back"
	need=$(( $(size_kb "$target") + MARGIN_KB )); have=$(free_kb "$parent")
	num "$have" && [ "$have" -ge "$need" ] || die "the router's own storage has ${have:-an unknown amount of} KiB free under $parent and needs $need"
	stop_gateway "$target"
	nobody_else_in "$target"
	{ mkdir -m 0700 "$tmp" && cp -a "$target/." "$tmp/" && same_tree "$target" "$tmp"; } \
		|| { rm -rf "$tmp"; die "the copy does not match the stick; nothing was switched"; }
	rmdir "$tmp/lost+found" 2>/dev/null
	n=$(files_in "$tmp")
	why=$(fstab_writable 2>&1) || { rm -rf "$tmp"; echo "$why" >&2; exit 1; }
	umount "$target" || { rm -rf "$tmp"; die "could not unmount $target; nothing was switched"; }
	[ -z "$(hermes_mount_source "$target")" ] || { rm -rf "$tmp"; die "$target is still a mount point after unmounting; nothing was switched"; }
	remount() { [ -d "$target" ] || mkdir -m 0700 "$target"; mount -t ext4 -o rw,noatime "$dev" "$target"; rm -rf "$tmp"; }
	# What lies underneath the mount point is set aside, never deleted.
	under=""
	if [ -n "$(ls -A "$target" 2>/dev/null)" ]; then
		under="$target.underneath.$(date +%Y%m%d%H%M%S)"
		mv "$target" "$under" || { remount; die "could not set aside what lies under $target; the stick is mounted again, nothing was switched"; }
	else
		rmdir "$target" || { remount; die "could not clear $target; the stick is mounted again, nothing was switched"; }
	fi
	[ -e "$target" ] && { remount; die "$target is still there; the stick is mounted again, nothing was switched"; }
	if ! mv "$tmp" "$target"; then
		[ -n "$under" ] && [ ! -e "$target" ] && mv "$under" "$target"
		remount; die "could not put the copy in place; the stick is mounted on $target again, nothing was switched"
	fi
	# only now does the router stop expecting the stick: one commit
	uci -q delete fstab.hermes_data
	if ! commit_fstab ""; then
		[ -z "$fstab_lost" ] || die "the data is back in $target, but /etc/config/fstab could neither be written nor put back as it was: rebuild it from $fstab_lost, leaving out section hermes_data, before the router restarts${under:+. What lay underneath the mount point is in $under}"
		die "the data is back in $target, but the stick's record could not be removed from /etc/config/fstab (is the router's own storage full or read-only?), so the router still expects the stick and Hermes does not start. Make room, then: uci delete fstab.hermes_data; uci commit fstab. Keep the stick: it still holds the same data${under:+. What lay underneath the mount point is in $under}"
	fi
	unlock; restart
	say "brought $n files back to $target on the router's own storage; the stick ($dev) is no longer used and can be removed${under:+. What lay underneath the mount point is kept in $under}"
}

forget() {
	[ "${1:-}" = --yes ] || die "forget gives up the stick of record: the data on it stays on it, the router stops expecting it, and Hermes starts again with an empty data directory inside. Run 'hermes-usb forget --yes' to do that; 'hermes-usb back' brings the data inside instead, with the stick mounted"
	lock
	uuid=$(hermes_data_stick)
	[ -n "$uuid" ] || die "no stick is on record; there is nothing to forget"
	target=$(uci -q get fstab.hermes_data.target)
	[ -z "$(hermes_mount_source "$target")" ] || die "a stick is mounted on $target; run 'hermes-usb back' to bring its data inside, or unmount it first to give it up"
	fstab_writable
	uci -q delete fstab.hermes_data
	if ! commit_fstab ""; then
		[ -z "$fstab_lost" ] || die "the stick's record could not be removed, and /etc/config/fstab could not be put back as it was: rebuild it from $fstab_lost, leaving out section hermes_data"
		die "the stick's record could not be removed from /etc/config/fstab (is the router's own storage full or read-only?); nothing was changed"
	fi
	unlock
	data_dir=$(uci -q get hermes.main.data_dir); [ -n "$data_dir" ] || data_dir=/srv/hermes
	say "the stick with UUID $uuid is no longer expected; its data is still on it. Hermes starts with an empty data directory in $data_dir when it is next started"
}

case "${1:-}" in
	status) status ;;
	move)   shift; move "$@" ;;
	back)   back ;;
	forget) shift; forget "$@" ;;
	*) echo "usage: hermes-usb status | move <partition> [--format] | back | forget --yes" >&2; exit 2 ;;
esac
